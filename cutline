_font = {"name": "monospace", "at": 0.0}


def current_font():
    # Asking the desktop spawns a process; the page asks often, so cache it briefly.
    if time.time() - _font["at"] > 15:
        for command in FONT_COMMANDS:
            try:
                name = subprocess.run(command, capture_output=True, text=True, timeout=3).stdout.strip()
            except (OSError, subprocess.TimeoutExpired):
                continue
            if name:
                _font["name"] = name
                break
        _font["at"] = time.time()
    return _font["name"]


