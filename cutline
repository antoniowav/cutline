def find_silences(path, start, end, noise=-35.0, least=0.5):
    """Quiet stretches in a file between start and end (seconds in the file), as [[from, to], ...]."""
    out = subprocess.run(["ffmpeg", "-nostats", "-hide_banner", "-ss", f"{start:.4f}", "-t", f"{end - start:.4f}",
                          "-i", str(path), "-vn", "-af", f"silencedetect=noise={noise:.1f}dB:d={least:.3f}",
                          "-f", "null", "-"], capture_output=True, text=True, timeout=600).stderr
    found, begin = [], None
    for line in out.splitlines():
        if m := re.search(r"silence_start: (-?[\d.]+)", line):
            begin = max(0.0, float(m.group(1)))
        elif (m := re.search(r"silence_end: (-?[\d.]+)", line)) and begin is not None:
            found.append([start + begin, start + float(m.group(1))])
            begin = None
    if begin is not None:                          # quiet right to the end
        found.append([start + begin, end])
    return found


def caption_words(file):
    """whisper.cpp's JSON (one word per segment) as [{t0, t1, w}], skipping [music]-style notes."""
    data = json.loads(Path(file).read_text(errors="replace"))
    words = []
    for seg in data.get("transcription", []):
        text = str(seg.get("text", "")).strip()
        if not text or re.fullmatch(r"[\[(*♪].*[\])*♪]", text):
            continue
        off = seg.get("offsets", {})
        words.append({"t0": int(off.get("from", 0)) / 1000, "t1": int(off.get("to", 0)) / 1000, "w": text})
    return words


