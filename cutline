@functools.cache
def tonemap():
    """The best HDR→SDR filter this ffmpeg can actually run, tried once on a tiny HLG clip."""
    test = ("color=c=gray:s=64x64:d=0.1,format=yuv420p10le,"
            "setparams=color_primaries=bt2020:color_trc=arib-std-b67:colorspace=bt2020nc")
    for vf in (TONEMAP, TONEMAP_CPU):
        try:
            if subprocess.run(["ffmpeg", "-v", "error", "-f", "lavfi", "-i", test, "-vf", vf, "-f", "null", "-"],
                              capture_output=True, timeout=30).returncode == 0:
                return vf
        except (OSError, subprocess.TimeoutExpired):
            pass
    print("cutline: no working HDR tone mapping (libplacebo or zscale); HDR videos will look washed out",
          file=sys.stderr)
    return f"format=yuv420p,{SDR_TAGS}"


@functools.cache
def gpu_encoder():
    """True when ffmpeg can encode H.264 on the GPU (VA-API), tried once on a tiny clip.
    The export then leaves the CPU to decoding: much faster and cooler than x264."""
    try:
        return subprocess.run(["ffmpeg", "-v", "error", *VAAPI_DEVICE, "-f", "lavfi", "-i",
                               "color=s=256x144:d=0.2", "-vf", "format=nv12,hwupload",
                               "-c:v", "h264_vaapi", "-qp", "21", "-f", "null", "-"],
                              capture_output=True, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def louder(measured):
    """The second loudness pass: loudnorm told what the first pass measured, so it applies one
    fixed gain. Silence (nothing to measure) is left as it is."""
    try:
        m = json.loads(measured[measured.rindex("{"):measured.rindex("}") + 1])
        values = [float(m[k]) for k in ("input_i", "input_tp", "input_lra", "input_thresh", "target_offset")]
    except (ValueError, KeyError):
        return "anull"
    if not all(math.isfinite(v) for v in values):
        return "anull"
    i, tp, lra, thresh, offset = values
    return (f"loudnorm={LOUDNESS}:measured_I={i}:measured_TP={tp}:measured_LRA={lra}:"
            f"measured_thresh={thresh}:offset={offset}:linear=true,aresample=48000")


def rotation(stream):
    """Degrees a video stream is turned when played: the display matrix, or the
    older "rotate" tag."""
    for side in stream.get("side_data_list", []):
        if "rotation" in side:
            return round(float(side["rotation"]))
    try:
        return round(float(stream.get("tags", {}).get("rotate", 0)))
    except ValueError:
        return 0


def attached_picture(stream):
    """Album art in a music file shows up as a one-frame video stream: it isn't video."""
    return bool(stream.get("disposition", {}).get("attached_pic"))


def seconds(value):
    try:
        x = float(value)
    except (TypeError, ValueError):
        return 0.0
    return x if math.isfinite(x) and x > 0 else 0.0


def probe(path):
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-show_entries",
         "format=duration:stream=codec_type,codec_name,pix_fmt,width,height,r_frame_rate,nb_frames,channels,"
         "color_transfer,color_primaries:stream_disposition=attached_pic:stream_side_data=rotation:stream_tags=rotate",
         "-of", "json", str(path)],
        capture_output=True, text=True, check=True).stdout
    data = json.loads(out)
    info = {"duration": seconds(data["format"].get("duration")), "width": 0,
            "height": 0, "fps": 30.0, "audio": False, "channels": 0, "hdr": False, "video": False}
    if Path(path).suffix.lower() in IMAGE_EXT:
        return probe_image(path, data, info)
    for s in data.get("streams", []):
        if s["codec_type"] == "video" and not info["width"] and not attached_picture(s):
            info["video"] = True
            info["width"], info["height"] = s["width"], s["height"]
            # Phones store a video as shot and tag how to turn it; ffmpeg turns the
            # frames when it decodes them, so a quarter turn swaps the size we show.
            if rotation(s) % 180 == 90:
                info["width"], info["height"] = info["height"], info["width"]
            num, den = s.get("r_frame_rate", "30/1").split("/")
            info["fps"] = round(float(num) / float(den or 1), 3) or 30.0
            info["hdr"] = (s.get("color_transfer") in ("arib-std-b67", "smpte2084")
                           or s.get("color_primaries") == "bt2020")
        elif s["codec_type"] == "audio" and not info["audio"]:
            info["audio"] = True
            info["channels"] = int(s.get("channels") or 2)
    if not info["video"] and not info["audio"]:
        raise ValueError("no video or audio stream")
    return info


def probe_image(path, data, info):
    """A photo, a sticker or an animated GIF/WebP. It loops, so it can be any length on the
    timeline: "duration" is one round of it (a still is one second)."""
    s = next((s for s in data.get("streams", []) if s["codec_type"] == "video"), None)
    if not s:
        raise ValueError("not a picture")
    num, den = (s.get("r_frame_rate") or "10/1").split("/")
    fps = float(num) / float(den or 1) or 10.0
    frames = int(s["nb_frames"]) if str(s.get("nb_frames", "")).isdigit() else 0
    animated = s.get("codec_name") in ("gif", "webp_anim")
    if animated and not frames:                # animated WebP: count them
        out = subprocess.run(["ffprobe", "-v", "error", "-count_frames", "-select_streams", "v:0", "-show_entries",
                              "stream=nb_read_frames", "-of", "csv=p=0", str(path)], capture_output=True, text=True)
        frames = int(out.stdout.strip() or 0) if out.stdout.strip().isdigit() else 0
    animated = animated and frames > 1
    info.update(video=True, width=s["width"], height=s["height"], image=True, loop=True, still=not animated,
                fps=round(fps, 3) if animated else 30.0,
                # transparent pixels (stickers): kept all the way to the export
                alpha=any(k in (s.get("pix_fmt") or "") for k in ("rgba", "bgra", "argb", "abgr", "yuva", "pal8", "ya")),
                duration=(info["duration"] or frames / fps) if animated else 1.0)
    return info


