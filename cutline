FULL_BOX = {"x": 0.0, "y": 0.0, "w": 1.0, "h": 1.0}


def clean_box(box):
    """A free clip's box, as shares of the canvas. It may hang off the edges a little."""
    box = box if isinstance(box, dict) else FULL_BOX
    return {"x": num(box.get("x", 0), -1, 1), "y": num(box.get("y", 0), -1, 1),
            "w": num(box.get("w", 1), 0.02, 2), "h": num(box.get("h", 1), 0.02, 2)}


def clean_crop(crop):
    """How much is cut off each edge of a clip's picture, as shares of it. At least 5 % of the
    picture stays each way (an Auto Short crops a wide video down to a tall strip)."""
    crop = crop if isinstance(crop, dict) else {}
    out = {side: num(crop.get(side, 0), 0, 0.9) for side in "ltrb"}
    for a, b in (("l", "r"), ("t", "b")):
        if out[a] + out[b] > 0.95:
            k = 0.95 / (out[a] + out[b])
            out[a], out[b] = out[a] * k, out[b] * k
    return out


TRANSITIONS = {"fade": "fade", "dip": "fadeblack", "slide": "slideleft", "wipe": "wipeleft",
               "circle": "circleopen", "zoom": "zoomin"}       # Cutline's name: ffmpeg xfade's
KEY_FIELDS = ("zoom", "fx", "fy", "x", "y")


def clean_keys(keys, c):
    """Keyframes: zoom, focus and (for a free clip) position at t seconds into the clip.
    Between two keys the value eases in and out; before the first and after the last it holds."""
    if not isinstance(keys, list):
        return []
    box = c.get("box") if isinstance(c.get("box"), dict) else {}
    out = []
    for k in keys[:64]:
        if not isinstance(k, dict):
            continue
        out.append({"t": num(k.get("t", 0), 0, 1e6), "zoom": num(k.get("zoom", 1), 1, 4),
                    "fx": num(k.get("fx", 0.5), 0, 1), "fy": num(k.get("fy", 0.5), 0, 1),
                    "x": num(k.get("x", box.get("x", 0)), -1, 1), "y": num(k.get("y", box.get("y", 0)), -1, 1)})
    return sorted(out, key=lambda k: k["t"])


def clean_trans(trans):
    """How a clip comes in from the clip right before it on its track."""
    if not isinstance(trans, dict) or trans.get("type") not in TRANSITIONS:
        return None
    return {"type": trans["type"], "dur": num(trans.get("dur", 0.5), 0.1, 3)}


def clean_color(color):
    color = color if isinstance(color, dict) else {}
    return {"b": num(color.get("b", 1), 0.3, 2), "c": num(color.get("c", 1), 0.3, 2),
            "s": num(color.get("s", 1), 0, 3), "t": num(color.get("t", 0), -1, 1)}


def clean_key(key):
    """A green screen: the colour to take out, how close a colour must be, how soft the edge."""
    if not isinstance(key, dict) or not key.get("on"):
        return None
    return {"color": colour(key.get("color"), "#00ff00"), "sim": num(key.get("sim", 0.15), 0.01, 0.6),
            "blend": num(key.get("blend", 0.08), 0, 0.5)}


def color_matrix(color):
    """The colour adjustment as one 3x3 matrix and an offset, on RGB in 0..1: brightness, then
    warmth, then saturation (the CSS/SVG saturate matrix), then contrast around the middle.
    The editor's colorMatrix() builds the same, for an SVG feColorMatrix."""
    b, c, s, w = color["b"], color["c"], color["s"], color["t"]
    sat = [[0.213 + 0.787 * s, 0.715 - 0.715 * s, 0.072 - 0.072 * s],
           [0.213 - 0.213 * s, 0.715 + 0.285 * s, 0.072 - 0.072 * s],
           [0.213 - 0.213 * s, 0.715 - 0.715 * s, 0.072 + 0.928 * s]]
    warm = [1 + 0.2 * w, 1 + 0.03 * w, 1 - 0.2 * w]
    m = [[c * sat[i][j] * warm[j] * b for j in range(3)] for i in range(3)]
    return m, 0.5 * (1 - c)


def lut_file(path):
    """A .cube LUT the user picked: only from the LUT folders, and not absurdly big."""
    if not path:
        return None
    real = Path(os.path.realpath(str(path)))
    for root in LUT_DIRS:
        root = Path(os.path.realpath(root))
        if real.suffix.lower() == ".cube" and root in real.parents and real.is_file() and real.stat().st_size <= MAX_LUT:
            return real
    return None


def list_luts():
    files = []
    for root in LUT_DIRS:
        if root.is_dir():
            depth = ("*",) if root == DOWNLOADS else ("*", "*/*")
            files += [f for d in depth for f in root.glob(d) if f.suffix.lower() == ".cube" and f.is_file()]
    return [{"path": str(f), "name": f.stem, "where": home_label(f.parent)}
            for f in sorted(set(files), key=lambda f: f.stem.lower())]


