@functools.cache
def tonemap():
    """The best HDR→SDR filter this ffmpeg can actually run, tried once on a tiny HLG clip."""
    test = ("color=c=gray:s=64x64:d=0.1,format=yuv420p10le,"
            "setparams=color_primaries=bt2020:color_trc=arib-std-b67:colorspace=bt2020nc")
    for vf in (TONEMAP, TONEMAP_CPU):
        try:
            if subprocess.run(["ffmpeg", "-v", "error", "-f", "lavfi", "-i", test, "-vf", vf, "-f", "null", "-"],
                              capture_output=True, timeout=30).returncode == 0:
                return vf
        except (OSError, subprocess.TimeoutExpired):
            pass
    print("cutline: no working HDR tone mapping (libplacebo or zscale); HDR videos will look washed out",
          file=sys.stderr)
    return f"format=yuv420p,{SDR_TAGS}"


def probe(path):
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-show_entries",
         "format=duration:stream=codec_type,width,height,r_frame_rate,channels,"
         "color_transfer,color_primaries",
         "-of", "json", str(path)],
        capture_output=True, text=True, check=True).stdout
    data = json.loads(out)
    info = {"duration": float(data["format"]["duration"]), "width": 0,
            "height": 0, "fps": 30.0, "audio": False, "channels": 0, "hdr": False}
    for s in data.get("streams", []):
        if s["codec_type"] == "video" and not info["width"]:
            info["width"], info["height"] = s["width"], s["height"]
            num, den = s.get("r_frame_rate", "30/1").split("/")
            info["fps"] = round(float(num) / float(den or 1), 3) or 30.0
            info["hdr"] = (s.get("color_transfer") in ("arib-std-b67", "smpte2084")
                           or s.get("color_primaries") == "bt2020")
        elif s["codec_type"] == "audio" and not info["audio"]:
            info["audio"] = True
            info["channels"] = int(s.get("channels") or 2)
    if not info["width"]:
        raise ValueError("no video stream")
    return info


def theme():
    colors = {"background": "#1a1b26", "foreground": "#c0caf5", "accent": "#7aa2f7",
              "muted": "#565f89", "red": "#f7768e", "selection": "#33467c",
              "dark_background": "#16161e", "lighter_background": "#24283b",
              "green": "#9ece6a", "yellow": "#e0af68", "magenta": "#bb9af7"}
    try:
        colors.update({k: v for k, v in tomllib.loads(THEME.read_text()).items()
                       if isinstance(v, str) and v.startswith("#")})
    except (OSError, tomllib.TOMLDecodeError):
        pass
    return {"colors": colors, "font": current_font()}


_font = {"name": "monospace", "at": 0.0}


def current_font():
    # `omarchy font current` spawns a process; the page asks often, so cache it briefly.
    if time.time() - _font["at"] > 15:
        try:
            _font["name"] = subprocess.run(["omarchy", "font", "current"], capture_output=True,
                                           text=True, timeout=3).stdout.strip() or "monospace"
        except (OSError, subprocess.TimeoutExpired):
            pass
        _font["at"] = time.time()
    return _font["name"]


MAX_BODY = 16 << 20                  # a project is a few KB; refuse anything absurd
LAYOUTS = {"full", "tl", "tr", "bl", "br"}


def safe_name(name):
    """A project name that is safe as a file name: no slashes, no control characters."""
    return re.sub(r"[^\w .,()'&+-]+", "", str(name)).strip().lstrip(".")[:80]


def num(value, lo, hi):
    x = float(value)
    if not math.isfinite(x):
        raise ValueError("not a number")
    return min(max(x, lo), hi)


def clean_project(p):
    """What the export reads from a project, every value checked: these end up in a file
    name and in ffmpeg's filter graph, and the project comes in over HTTP."""
    try:
        canvas = p["canvas"]
        return {
            "name": safe_name(p.get("name", "")) or "project",
            "canvas": {"w": int(num(canvas["w"], 16, 8192)), "h": int(num(canvas["h"], 16, 8192)),
                       "fps": round(num(canvas.get("fps") or 30, 1, 240), 3)},
            "sources": [{"id": str(src["id"])} for src in p.get("sources", [])],
            "tracks": [{"id": int(t["id"]), "hidden": bool(t.get("hidden")), "muted": bool(t.get("muted"))}
                       for t in p["tracks"]],
            "clips": [{"id": int(c["id"]), "src": str(c["src"]), "track": int(c["track"]),
                       "start": num(c["start"], 0, 1e6), "in": num(c["in"], 0, 1e6), "out": num(c["out"], 0, 1e6),
                       "layout": c.get("layout") if c.get("layout") in LAYOUTS else "full",
                       "size": num(c.get("size", 0.3), 0.05, 1), "volume": num(c.get("volume", 1), 0, 4)}
                      for c in p["clips"]],
        }
    except (KeyError, TypeError, ValueError, AttributeError) as e:
        raise ValueError("This project can't be exported: its data is damaged") from e


def project_path(file):
    """The project file the page means, only ever looked up inside PROJECTS: just the
    file name is taken from the request, and the result must still be inside it."""
    root = os.path.realpath(PROJECTS)
    path = os.path.realpath(os.path.join(root, os.path.basename(str(file))))
    if not path.startswith(root + os.sep) or not path.endswith(".json"):
        raise ValueError("Unknown project")
    return Path(path)


def source_id(path):
    return hashlib.sha1(str(path).encode(), usedforsecurity=False).hexdigest()[:12]   # an id, not security


class Source:
    """One video file: probe info plus thumbnail strip and waveform, made in the background."""

    def __init__(self, path):
        self.path = Path(path)
        self.id = source_id(self.path)
        self.info = probe(self.path)
        key = hashlib.sha1(f"{self.path}:{self.path.stat().st_mtime}".encode(), usedforsecurity=False).hexdigest()[:16]
        self.cache = CACHE / key
        self.cache.mkdir(parents=True, exist_ok=True)
        self.thumbs = max(1, min(400, math.ceil(self.info["duration"] / 2)))
        self.thumb_w = round(THUMB_H * self.info["width"] / max(1, self.info["height"])) or 128
        self.sprite = self.cache / "sprite-grid.jpg"
        self.cols = min(SPRITE_COLS, self.thumbs)
        self.peaks = self.cache / "peaks.json"
        self.proxy = self.cache / "proxy.mp4"
        self.proxy_progress = 1.0 if self.proxy.exists() else 0.0
        threading.Thread(target=self.make_sprite, daemon=True).start()
        threading.Thread(target=self.make_peaks, daemon=True).start()
        threading.Thread(target=self.make_proxy, daemon=True).start()

    def public(self):
        return {"id": self.id, "path": str(self.path), "name": self.path.name, **self.info,
                "thumbs": self.thumbs, "thumbW": self.thumb_w, "thumbH": THUMB_H,
                "spriteReady": self.sprite.exists(), "spriteCols": self.cols,
                "peaksReady": self.peaks.exists() or not self.info["audio"],
                "proxyReady": self.proxy.exists(), "proxyProgress": round(self.proxy_progress, 3)}

    def media(self):
        return self.proxy if self.proxy.exists() else self.path

    # A small, keyframe-dense H.264 copy: seeks instantly and decodes cheaply.
    # Made on the GPU (VA-API) when possible, so it doesn't heat up the CPU.
    def make_proxy(self):
        if self.proxy.exists():
            return
        tmp = self.proxy.with_suffix(".tmp.mp4")
        audio = ["-c:a", "aac", "-b:a", "128k"] if self.info["audio"] else ["-an"]
        tail = ["-r", "30", "-g", "15", *audio, "-movflags", "+faststart",
                "-progress", "pipe:1", "-nostats", str(tmp)]
        gpu = ["ffmpeg", "-v", "error", "-y", "-hwaccel", "vaapi", "-hwaccel_output_format", "vaapi",
               "-i", str(self.path), "-vf", f"scale_vaapi=w=-2:h={PROXY_H}:format=nv12",
               "-c:v", "h264_vaapi", "-qp", "26", *tail]
        cpu = ["ffmpeg", "-v", "error", "-y", "-i", str(self.path),
               "-vf", f"scale=-2:{PROXY_H},format=yuv420p", "-c:v", "libx264",
               "-preset", "ultrafast", "-crf", "26", "-threads", "4", *tail]
        hdr = ["ffmpeg", "-v", "error", "-y", "-i", str(self.path),
               "-vf", f"{tonemap()},scale=-2:{PROXY_H}", "-c:v", "libx264",
               "-preset", "ultrafast", "-crf", "26", "-threads", "4", *tail]
        for cmd in ((hdr, cpu) if self.info.get("hdr") else (gpu, cpu)):
            proc = subprocess.Popen(["nice", "-n", "10", *cmd], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True)
            for line in proc.stdout:
                if m := re.match(r"out_time_us=(\d+)", line):
                    self.proxy_progress = min(0.99, int(m.group(1)) / 1e6 / self.info["duration"])
            if proc.wait() == 0 and tmp.exists():
                tmp.rename(self.proxy)
                self.proxy_progress = 1.0
                return
            tmp.unlink(missing_ok=True)
            self.proxy_progress = 0.0

    # Keyframes only (-skip_frame nokey): a long recording is skimmed in seconds.
    # A short clip may have a single keyframe, which leaves nothing to tile: then
    # decode every frame instead.
    def make_sprite(self):
        if self.sprite.exists():
            return
        tmp = self.sprite.with_suffix(".tmp.jpg")
        fps = self.thumbs / self.info["duration"]
        rows = math.ceil(self.thumbs / self.cols)
        vf = f"fps={fps:.6f},scale={self.thumb_w}:{THUMB_H},tile={self.cols}x{rows}"
        for skip in (["-skip_frame", "nokey"], []):
            subprocess.run(["nice", "-n", "10", "ffmpeg", "-v", "error", "-y", *skip, "-i", str(self.path),
                            "-an", "-vf", vf, "-frames:v", "1", "-q:v", "5", str(tmp)],
                           stderr=subprocess.DEVNULL)
            if tmp.exists() and tmp.stat().st_size:
                tmp.rename(self.sprite)
                return
            tmp.unlink(missing_ok=True)

    # Peak level per 50 ms: enough to see the pauses between sentences.
    def make_peaks(self):
        if self.peaks.exists() or not self.info["audio"]:
            return
        rate, step = 8000, 400
        proc = subprocess.Popen(
            ["nice", "-n", "10", "ffmpeg", "-v", "error", "-i", str(self.path),
             "-vn", "-ac", "1", "-ar", str(rate), "-f", "s16le", "-"],
            stdout=subprocess.PIPE)
        peaks = []
        while chunk := proc.stdout.read(step * 2):
            vals = memoryview(chunk[: len(chunk) // 2 * 2]).cast("h")
            peaks.append(max((abs(v) for v in vals), default=0) / 32768)
        proc.wait()
        top = max(peaks, default=1) or 1
        tmp = self.peaks.with_suffix(".tmp")
        tmp.write_text(json.dumps({"step": step / rate, "peaks": [round(p / top, 3) for p in peaks]}))
        tmp.replace(self.peaks)


class App:
    def __init__(self):
        PROJECTS.mkdir(parents=True, exist_ok=True)
        self.sources = {}
        self.project_file = None
        self.export = {"state": "idle", "progress": 0.0, "output": "", "error": ""}
        self.export_proc = None
        self.last_beat = time.time()
        self.lock = threading.Lock()
        # Any program on this computer can reach 127.0.0.1, including other users' ones. The
        # window proves it's ours with a cookie, handed out once for the key in its start URL.
        self.session = secrets.token_urlsafe(32)
        self.launch_key = secrets.token_urlsafe(32)

    def busy(self):
        return self.export["state"] == "running"

    def source(self, path):
        path = Path(path).expanduser().resolve()
        sid = source_id(path)
        if sid not in self.sources:
            if not path.is_file() or path.suffix.lower() not in VIDEO_EXT:
                raise ValueError(f"Not a video file: {path.name}")
            self.sources[sid] = Source(path)
        return self.sources[sid]

    # ---- projects ----
    def new_project(self, video):
        src = self.source(video)
        base = safe_name(src.path.stem) or "project"
        name, n = base, 2
        while (PROJECTS / f"{name}.json").exists():
            name, n = f"{base} {n}", n + 1
        info = src.info
        project = {
            "version": 2, "name": name, "created": time.strftime("%Y-%m-%d %H:%M"),
            "canvas": {"w": info["width"] // 2 * 2, "h": info["height"] // 2 * 2,
                       "fps": min(60, info["fps"] or 30)},
            "sources": [{"id": src.id, "path": str(src.path)}],
            "tracks": [{"id": 1, "name": "V1", "hidden": False, "muted": False},
                       {"id": 2, "name": "V2", "hidden": False, "muted": False}],
            "clips": [{"id": 1, "src": src.id, "track": 1, "start": 0.0,
                       "in": 0.0, "out": info["duration"], "layout": "full", "size": 0.3}],
        }
        self.project_file = PROJECTS / f"{name}.json"
        self.save(project)

    def open_project(self, file):
        file = project_path(file)
        if not file.is_file():
            raise ValueError("Unknown project")
        project = json.loads(file.read_text())
        for s in project.get("sources", []):
            try:
                self.source(s["path"])
            except (ValueError, OSError, subprocess.CalledProcessError):
                pass                                   # missing file: its clips show as offline
        self.project_file = file

    def rename(self, file, new_name):
        """Rename a project: its name inside and its file. Returns the new name."""
        file = project_path(file)
        if not file.is_file():
            raise ValueError("Unknown project")
        name = safe_name(new_name)
        if not name:
            raise ValueError("Give the project a name")
        target = PROJECTS / f"{name}.json"
        if target.exists() and target.resolve() != file:
            raise ValueError(f'A project called "{name}" already exists')
        project = json.loads(file.read_text())
        project["name"] = name
        tmp = target.with_suffix(".tmp")
        tmp.write_text(json.dumps(project, indent=1))
        tmp.replace(target)
        if target.resolve() != file:
            file.unlink()
        if self.project_file and self.project_file.resolve() == file:
            self.project_file = target
        return name

    def load(self):
        return json.loads(self.project_file.read_text())

    def save(self, project):
        tmp = self.project_file.with_suffix(".tmp")
        tmp.write_text(json.dumps(project, indent=1))
        tmp.replace(self.project_file)

    def list_projects(self):
        out = []
        for f in sorted(PROJECTS.glob("*.json"), key=lambda f: f.stat().st_mtime, reverse=True):
            try:
                p = json.loads(f.read_text())
            except (OSError, json.JSONDecodeError):
                continue
            out.append({"file": str(f), "name": p.get("name", f.stem),
                        "modified": time.strftime("%Y-%m-%d %H:%M", time.localtime(f.stat().st_mtime)),
                        "clips": len(p.get("clips", [])), "videos": len(p.get("sources", []))})
        return out

    # ---- export ----
    def start_export(self, project, scale1080):
        with self.lock:
            if self.busy():
                return
            try:
                args, total, out = self.build_export(project, scale1080)
            except ValueError as e:
                self.export = {"state": "error", "progress": 0, "output": "", "error": str(e)}
                return
            self.export = job = {"state": "running", "progress": 0.0, "output": str(out), "error": ""}
        threading.Thread(target=self.run_export, args=(job, args, total, out), daemon=True).start()

    def build_export(self, project, scale1080):
        project = clean_project(project)
        W, H = project["canvas"]["w"] // 2 * 2, project["canvas"]["h"] // 2 * 2
        FPS = project["canvas"].get("fps") or 30
        tracks = {t["id"]: t for t in project["tracks"]}
        order = [t["id"] for t in project["tracks"]]             # bottom → top
        clips = [c for c in project["clips"]
                 if c["track"] in tracks and not tracks[c["track"]].get("hidden")
                 and c["src"] in self.sources and c["out"] - c["in"] > 0.04]
        if not clips:
            raise ValueError("Nothing to export: the timeline is empty.")
        clips.sort(key=lambda c: (order.index(c["track"]), c["start"]))

        # Snap every clip to whole frames, and cut video AND audio to exactly that many
        # frames. Otherwise each joined clip is rounded a little differently and over many
        # cuts the picture drifts away from the sound.
        frames = lambda x: int(round(x * FPS))
        base_track = clips[0]["track"]
        base = [c for c in clips if c["track"] == base_track and c.get("layout", "full") == "full"]
        sf, nf, cursor = {}, {}, 0
        for c in clips:
            i = id(c)
            nf[i] = max(1, frames(c["out"] - c["in"]))
            sf[i] = frames(c["start"])
            if c in base:                          # the base track is one continuous strip
                sf[i] = max(sf[i], cursor)
                cursor = sf[i] + nf[i]
        total_f = max(sf[id(c)] + nf[id(c)] for c in clips)
        total = total_f / FPS
        first_id = project["sources"][0]["id"] if project.get("sources") else clips[0]["src"]
        first = self.sources.get(first_id) or self.sources[clips[0]["src"]]
        out = self.output_path(first.path.parent, project["name"], scale1080 and H > 1080)

        args = ["ffmpeg", "-v", "error", "-y", "-progress", "pipe:1", "-nostats"]
        graph, audio = [], []
        for c in clips:                            # a little extra input, trimmed exactly below
            args += ["-ss", f"{c['in']:.4f}", "-t", f"{nf[id(c)] / FPS + 0.25:.4f}",
                     "-i", str(self.sources[c["src"]].path)]

        def video(k, c, pad_full):
            full = c.get("layout", "full") == "full"
            size = float(c.get("size", 0.3))
            bw, bh = (W, H) if full else (max(16, round(W * size) // 2 * 2), max(16, round(H * size) // 2 * 2))
            color = tonemap() if self.sources[c["src"]].info.get("hdr") else f"format=yuv420p,{SDR_TAGS}"
            f = (f"[{k}:v:0]fps={FPS},{color},scale={bw}:{bh}:force_original_aspect_ratio=decrease,"
                 f"scale=trunc(iw/2)*2:trunc(ih/2)*2")
            if pad_full and full:
                f += f",pad={W}:{H}:(ow-iw)/2:(oh-ih)/2:black"
            # exactly n frames: hold the last frame if the source runs short, then cut
            return (f + f",setsar=1,format=yuv420p,setpts=PTS-STARTPTS,"
                        f"tpad=stop_mode=clone:stop_duration={3 / FPS:.4f},trim=end_frame={nf[id(c)]}")

        def black(label, n):
            graph.append(f"color=black:s={W}x{H}:r={FPS}:d={(n + 2) / FPS:.4f},format=yuv420p,{SDR_TAGS},"
                         f"trim=end_frame={n},setpts=PTS-STARTPTS[{label}]")

        # Bottom visible track: one concat with black gaps (cheap).
        segs, at, n = [], 0, 0
        for c in base:
            k = clips.index(c)
            if sf[id(c)] > at:
                black(f"g{n}", sf[id(c)] - at); segs.append(f"[g{n}]"); n += 1
            graph.append(video(k, c, True) + f",setpts=PTS-STARTPTS[s{k}]")
            segs.append(f"[s{k}]")
            at = sf[id(c)] + nf[id(c)]
        if total_f > at:
            black(f"g{n}", total_f - at); segs.append(f"[g{n}]")
        # re-time by frame number: the joined strip is exactly sum(n) frames, so frame N sits at N/FPS
        graph.append(f"{''.join(segs)}concat=n={len(segs)}:v=1:a=0,setpts=N/({FPS}*TB)[b0]")

        # Everything else is overlaid on top, in track order.
        m = CORNER_MARGIN
        pos = {"full": ("(W-w)/2", "(H-h)/2"), "tl": (f"W*{m}", f"W*{m}"),
               "tr": (f"W-w-W*{m}", f"W*{m}"), "bl": (f"W*{m}", f"H-h-W*{m}"),
               "br": (f"W-w-W*{m}", f"H-h-W*{m}")}
        layer = 0
        for k, c in enumerate(clips):
            if c in base:
                continue
            st, en = sf[id(c)] / FPS, (sf[id(c)] + nf[id(c)]) / FPS
            x, y = pos.get(c.get("layout", "full"), pos["full"])
            graph.append(video(k, c, False) + f",setpts=PTS-STARTPTS+{st:.4f}/TB[o{k}]")
            graph.append(f"[b{layer}][o{k}]overlay=x={x}:y={y}:eof_action=pass:"
                         f"enable='between(t,{st:.4f},{en - 0.5 / FPS:.4f})'[b{layer + 1}]")
            layer += 1
        graph.append(f"[b{layer}]" + ("scale=-2:1080," if scale1080 and H > 1080 else "")
                     + f"format=yuv420p,{SDR_TAGS},trim=end_frame={total_f}[vout]")

        # Audio: every clip on an unmuted track, cut to the same frames, placed and mixed.
        for k, c in enumerate(clips):
            gain = float(c.get("volume", 1))
            if tracks[c["track"]].get("muted") or gain <= 0 or not self.sources[c["src"]].info["audio"]:
                continue
            d = nf[id(c)] / FPS
            fade = min(0.02, d / 4)
            ms = int(round(sf[id(c)] / FPS * 1000))
            # mono: copy to both sides at full level (a plain upmix would drop it by 3 dB)
            to_stereo = "pan=stereo|c0=c0|c1=c0" if self.sources[c["src"]].info.get("channels") == 1 \
                else "aformat=channel_layouts=stereo"
            graph.append(f"[{k}:a:0]aresample=48000,{to_stereo},asetpts=PTS-STARTPTS,"
                         f"apad=whole_dur={d:.4f},atrim=duration={d:.4f},"
                         f"volume={gain:.3f},afade=t=in:d={fade:.3f},afade=t=out:st={max(0, d - fade):.4f}:d={fade:.3f},"
                         f"adelay={ms}|{ms}[a{k}]")
            audio.append(f"[a{k}]")
        graph.append(f"anullsrc=r=48000:cl=stereo,atrim=0:{total:.4f}[asil]")
        graph.append(f"[asil]{''.join(audio)}amix=inputs={len(audio) + 1}:duration=first:normalize=0,"
                     f"alimiter=limit=0.97:attack=5:release=50:level=false[aout]")

        args += ["-filter_complex", ";".join(graph), "-map", "[vout]", "-map", "[aout]",
                 "-c:v", "libx264", "-preset", "fast", "-crf", "20", "-r", str(FPS),
                 "-colorspace", "bt709", "-color_primaries", "bt709", "-color_trc", "bt709", "-color_range", "tv",
                 "-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart", "-threads", "6",
                 "-t", f"{total:.4f}", str(out)]
        return args, total, out

    @staticmethod
    def output_path(folder, name, small):
        base = folder / f"{name}-edit{'-1080p' if small else ''}.mp4"
        path, n = base, 2
        while path.exists():
            path = base.with_name(f"{base.stem}-{n}.mp4")
            n += 1
        return path

    # Each run only ever updates its own job: a cancelled run that is still winding down
    # must not touch the export started after it.
    def run_export(self, job, args, total, out):
        proc = subprocess.Popen(["nice", "-n", "5", *args], stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
        self.export_proc = proc
        err = []
        reader = threading.Thread(target=lambda: err.extend(proc.stderr), daemon=True)
        reader.start()
        for line in proc.stdout:
            m = re.match(r"out_time_us=(\d+)", line)
            if m and total:
                job["progress"] = min(0.999, int(m.group(1)) / 1e6 / total)
        code = proc.wait()
        reader.join(timeout=2)
        if self.export_proc is proc:
            self.export_proc = None
        if code == 0 and job["state"] != "cancelled":
            job.update(state="done", progress=1.0)
        elif job["state"] != "cancelled":
            out.unlink(missing_ok=True)
            job.update(state="error", error="".join(err).strip()[-800:] or f"ffmpeg exited {code}")

    def cancel_export(self):
        proc = self.export_proc
        if proc:
            self.export["state"] = "cancelled"
            proc.terminate()
            try:                                   # let it go before deleting its file, so the next
                proc.wait(timeout=10)              # export can't pick the same name while it's still open
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
            Path(self.export["output"]).unlink(missing_ok=True)


def home_label(path):
    """path with the home folder shown as ~, for the UI."""
    try:
        return "~/" + str(Path(path).relative_to(Path.home()))
    except ValueError:
        return str(path)


def list_videos():
    files = []
    for depth in ("*", "*/*", "*/*/*", "*/*/*/*"):    # subfolders too, e.g. an external drive
        files += [f for f in VIDEOS.glob(depth) if f.suffix.lower() in VIDEO_EXT
                  and not f.name.startswith(".") and f.is_file()]
    files.sort(key=lambda f: f.stat().st_mtime, reverse=True)
    return [{"path": str(f), "name": str(f.relative_to(VIDEOS)), "size": f.stat().st_size,
             "modified": time.strftime("%Y-%m-%d %H:%M", time.localtime(f.stat().st_mtime))}
            for f in files]


def handler_for(app: App):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send_json(self, obj, code=200):
            self.html = False
            body = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def end_headers(self):
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            if self.html:
                self.send_header("Content-Security-Policy", CSP)
            super().end_headers()

        html = False

        def send_file(self, path, ctype):
            self.html = ctype.startswith("text/html")
            size = path.stat().st_size
            start, end = 0, size - 1
            rng = self.headers.get("Range")
            if rng and (m := re.fullmatch(r"bytes=(\d*)-(\d*)", rng.strip())) and (m.group(1) or m.group(2)):
                if m.group(1):
                    start = int(m.group(1))
                    end = int(m.group(2)) if m.group(2) else size - 1
                else:
                    start = max(0, size - int(m.group(2)))
                end = min(end, size - 1)
                if start > end:
                    self.send_response(416)
                    self.send_header("Content-Range", f"bytes */{size}")
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                self.send_response(206)
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            else:
                self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Content-Length", str(end - start + 1))
            self.end_headers()
            try:
                with open(path, "rb") as f:
                    f.seek(start)
                    left = end - start + 1
                    while left > 0 and (chunk := f.read(min(1 << 20, left))):
                        self.wfile.write(chunk)
                        left -= len(chunk)
            except (BrokenPipeError, ConnectionResetError):
                pass

        def trusted(self):
            """Only our own page may talk to us: refuse other hosts (DNS rebinding) and,
            for POSTs, requests that other web pages send to this port."""
            port = self.server.server_address[1]
            host = self.headers.get("Host", "")
            if host not in (f"127.0.0.1:{port}", f"localhost:{port}"):
                return False
            origin = self.headers.get("Origin")
            if self.command != "GET" and origin is not None and origin != f"http://{host}":
                return False
            try:
                jar = SimpleCookie(self.headers.get("Cookie", ""))
            except CookieError:
                return False
            got = jar.get(self.cookie_name())
            return got is not None and hmac.compare_digest(got.value, app.session)

        def cookie_name(self):
            return f"cutline_{self.server.server_address[1]}"   # cookies ignore ports: one per server

        def launch(self):
            """The window's first request carries the one-time key: swap it for the session cookie."""
            key = re.search(r"[?&]key=([\w-]+)", self.path)
            if not key or not app.launch_key or not hmac.compare_digest(key.group(1), app.launch_key):
                return False
            app.launch_key = None
            self.send_response(303)
            self.send_header("Set-Cookie", f"{self.cookie_name()}={app.session}; Path=/; HttpOnly; SameSite=Strict")
            self.send_header("Location", "/")
            self.send_header("Content-Length", "0")
            self.end_headers()
            return True

        def do_GET(self):
            if self.path.startswith("/?") and self.launch():
                return None
            if not self.trusted():
                return self.send_json({"error": "forbidden: open Cutline from its launcher"}, 403)
            p = self.path.split("?")[0]
            if p == "/api/beat":
                app.last_beat = time.time()
                return self.send_json({"ok": True})
            if p == "/":
                page = "index.html" if app.project_file else "pick.html"
                return self.send_file(HERE / page, "text/html; charset=utf-8")
            if p == "/api/home":
                return self.send_json({"videos": list_videos(), "videosDir": home_label(VIDEOS),
                                       "projects": app.list_projects(), "theme": theme()})
            if p == "/api/theme":
                return self.send_json(theme())
            if p == "/api/videos":
                return self.send_json({"videos": list_videos(), "videosDir": home_label(VIDEOS)})
            if p == "/api/export":
                return self.send_json(app.export)
            if m := re.match(r"/(media|sprite|peaks|api/source)/([0-9a-f]{12})", p):
                src = app.sources.get(m.group(2))
                if not src:
                    return self.send_json({"error": "unknown source"}, 404)
                kind = m.group(1)
                if kind == "media":
                    ctype = {".mov": "video/quicktime", ".mkv": "video/x-matroska",
                             ".webm": "video/webm"}.get(src.path.suffix.lower(), "video/mp4")
                    media = src.media()
                    return self.send_file(media, "video/mp4" if media != src.path else ctype)
                if kind == "sprite" and src.sprite.exists():
                    return self.send_file(src.sprite, "image/jpeg")
                if kind == "peaks" and src.peaks.exists():
                    return self.send_file(src.peaks, "application/json")
                if kind == "api/source":
                    return self.send_json(src.public())
                return self.send_json({"error": "not ready"}, 404)
            if p == "/api/project":
                if not app.project_file:
                    return self.send_json({"error": "no project open"}, 404)
                return self.send_json({"project": app.load(), "theme": theme(),
                                       "sources": {sid: s.public() for sid, s in app.sources.items()},
                                       "export": app.export})
            self.send_json({"error": "not found"}, 404)

        def do_POST(self):
            if not self.trusted():
                return self.send_json({"error": "forbidden"}, 403)
            try:
                n = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                n = -1
            if not 0 <= n <= MAX_BODY:
                return self.send_json({"error": "bad request size"}, 413)
            try:
                body = json.loads(self.rfile.read(n) or b"null") or {}
            except (json.JSONDecodeError, UnicodeDecodeError):
                return self.send_json({"error": "bad json"}, 400)
            if not isinstance(body, dict):
                return self.send_json({"error": "bad json"}, 400)
            if self.path == "/api/bye":            # window closed or reloading
                app.last_beat = time.time() - IDLE_EXIT + CLOSE_GRACE
                return self.send_json({"ok": True})
            try:
                if self.path in ("/api/new", "/api/openproject", "/api/close") and app.busy():
                    return self.send_json({"error": "An export is still running"}, 409)
                if self.path == "/api/new":
                    app.new_project(body.get("path", ""))
                    return self.send_json({"ok": True})
                if self.path == "/api/openproject":
                    app.open_project(body.get("file", ""))
                    return self.send_json({"ok": True})
                if self.path == "/api/close":
                    app.project_file = None
                    return self.send_json({"ok": True})
                if self.path == "/api/renameproject":
                    return self.send_json({"ok": True, "name": app.rename(body.get("file", ""), body.get("name", ""))})
                if self.path == "/api/rename":
                    if not app.project_file:
                        return self.send_json({"error": "no project open"}, 404)
                    if app.busy():
                        return self.send_json({"error": "Wait for the export to finish"}, 409)
                    return self.send_json({"ok": True, "name": app.rename(app.project_file, body.get("name", ""))})
                if self.path == "/api/deleteproject":
                    f = project_path(body.get("file", ""))
                    if not app.project_file or f != app.project_file.resolve():   # never the open one
                        f.unlink(missing_ok=True)
                    return self.send_json({"ok": True})
                if not app.project_file:
                    return self.send_json({"error": "no project open"}, 404)
                if self.path == "/api/project":
                    app.save(body)
                    return self.send_json({"ok": True})
                if self.path == "/api/addsource":
                    return self.send_json(app.source(body.get("path", "")).public())
                if self.path == "/api/export":
                    app.start_export(body.get("project") or app.load(), bool(body.get("scale1080")))
                    return self.send_json(app.export)
                if self.path == "/api/export/cancel":
                    app.cancel_export()
                    return self.send_json({"ok": True})
                if self.path == "/api/reveal":
                    out = app.export.get("output")
                    if out:
                        subprocess.Popen(["xdg-open", str(Path(out).parent)],
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    return self.send_json({"ok": True})
            except (ValueError, TypeError, OSError, subprocess.CalledProcessError) as e:
                return self.send_json({"error": str(e) or "Could not read that file"}, 400)
            self.send_json({"error": "not found"}, 404)

    return Handler


def free_port():
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def default_browser():
    """The desktop's default browser, if it is Chromium-based (only those have --app windows)."""
    try:
        desktop = subprocess.run(["xdg-settings", "get", "default-web-browser"], capture_output=True,
                                 text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return None
    dirs = [xdg_dir("XDG_DATA_HOME", ".local/share"),
            *map(Path, (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":"))]
    for d in dirs:
        entry = d / "applications" / desktop
        if desktop.endswith(".desktop") and entry.is_file():
            exe = next((shlex.split(line[5:])[0] for line in entry.read_text(errors="ignore").splitlines()
                        if line.startswith("Exec=") and line[5:].strip()), "")
            chromium = any(k in Path(exe).name for k in ("chrom", "brave", "vivaldi", "edge", "thorium", "helium"))
            return exe if chromium and shutil.which(exe) else None
    return None


def open_window(url):
    """Open the editor as a chromeless app window; without a Chromium-based browser, as a normal tab."""
    if cmd := os.environ.get("CUTLINE_BROWSER"):
        argv = shlex.split(cmd)
    else:
        found = default_browser() or next((b for b in BROWSERS if shutil.which(b)), None)
        argv = [found] if found else None
    if argv and shutil.which(argv[0]):
        subprocess.Popen([*argv, f"--app={url}", "--new-window"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    print("cutline: no Chromium-based browser found (set CUTLINE_BROWSER); "
          "opening your default browser instead", file=sys.stderr)
    webbrowser.open(url)


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("-V", "--version"):
        print(f"cutline {VERSION}")
        sys.exit(0)
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help")):
        print(__doc__.strip())
        sys.exit(0 if len(sys.argv) == 2 else 2)
    if not shutil.which("ffmpeg"):
        sys.exit("cutline: ffmpeg is required")
    app = App()
    if len(sys.argv) == 2:
        try:
            app.new_project(sys.argv[1])
        except (ValueError, OSError, subprocess.CalledProcessError) as e:
            sys.exit(f"cutline: {e}")
    port = free_port()
    server = ThreadingHTTPServer(("127.0.0.1", port), handler_for(app))
    threading.Thread(target=server.serve_forever, daemon=True).start()
    url = f"http://127.0.0.1:{port}/?key={app.launch_key}"      # works once: it becomes a cookie
    if not os.environ.get("CUTLINE_NO_BROWSER"):
        open_window(url)
    print(f"cutline: {url}", flush=True)
    try:
        while time.time() - app.last_beat < IDLE_EXIT or app.busy():
            time.sleep(2)
    except KeyboardInterrupt:
        pass
    if app.busy():
        app.cancel_export()
    server.shutdown()


if __name__ == "__main__":
    main()
