_font = {"name": "monospace", "at": 0.0}


def current_font():
    # Asking the desktop spawns a process; the page asks often, so cache it briefly.
    if time.time() - _font["at"] > 15:
        for command in FONT_COMMANDS:
            try:
                name = subprocess.run(command, capture_output=True, text=True, timeout=3).stdout.strip()
            except (OSError, subprocess.TimeoutExpired):
                continue
            if name:
                _font["name"] = name
                break
        _font["at"] = time.time()
    return _font["name"]


MAX_BODY = 16 << 20                  # a project is a few KB; refuse anything absurd
LAYOUTS = {"full", "tl", "tr", "bl", "br", "free"}
FULL_BOX = {"x": 0.0, "y": 0.0, "w": 1.0, "h": 1.0}


def clean_box(box):
    """A free clip's box, as shares of the canvas. It may hang off the edges a little."""
    box = box if isinstance(box, dict) else FULL_BOX
    return {"x": num(box.get("x", 0), -1, 1), "y": num(box.get("y", 0), -1, 1),
            "w": num(box.get("w", 1), 0.02, 2), "h": num(box.get("h", 1), 0.02, 2)}


def clean_crop(crop):
    """How much is cut off each edge of a clip's picture, as shares of it (0 to 45 % each)."""
    crop = crop if isinstance(crop, dict) else {}
    return {side: num(crop.get(side, 0), 0, 0.45) for side in "ltrb"}


def safe_name(name):
    """A project name that is safe as a file name: no slashes, no control characters."""
    return re.sub(r"[^\w .,()'&+-]+", "", str(name)).strip().lstrip(".")[:80]


def num(value, lo, hi):
    x = float(value)
    if not math.isfinite(x):
        raise ValueError("not a number")
    return min(max(x, lo), hi)


COLOR = re.compile(r"#[0-9a-fA-F]{6}")
MAX_TEXT = 500


ANIM_IN = ("none", "fade", "pop", "slide", "type", "bounce")
ANIM_OUT = ("none", "fade", "pop", "slide")


def colour(value, default):
    return str(value).lower() if COLOR.fullmatch(str(value or "")) else default


def text_motion(c, st, en):
    """A title's animation as ffmpeg expressions over t: (alpha, scale, rise), where rise is a
    share of the canvas height. The editor's textMotion() computes the very same numbers."""
    d = en - st
    di, do = min(c["fadeIn"], d / 2), min(c["fadeOut"], d / 2)
    p = f"clip((t-{st:.4f})/{di:.4f},0,1)"
    q = f"clip(({en:.4f}-t)/{do:.4f},0,1)"
    alpha, scale, rise = [], [], []
    if di > 0:
        if c["animIn"] in ("fade", "slide"):
            alpha.append(p)
        if c["animIn"] == "pop":                       # overshoots a little, then settles (ease-out-back)
            alpha.append(f"min(1,3*{p})")
            scale.append(f"(1+2.70158*pow({p}-1,3)+1.70158*pow({p}-1,2))")
        if c["animIn"] == "bounce":                    # wobbles in size as it settles
            alpha.append(f"min(1,4*{p})")
            scale.append(f"(1+0.25*sin({p}*PI*3)*(1-{p}))")
        if c["animIn"] == "slide":                     # rises into place from a little below
            rise.append(f"(1-{p})*0.08")
    if do > 0:
        if c["animOut"] in ("fade", "slide", "pop"):
            alpha.append(q)
        if c["animOut"] == "pop":
            scale.append(f"(0.6+0.4*{q})")
        if c["animOut"] == "slide":
            rise.append(f"(1-{q})*0.08")
    return "*".join(alpha) or "1", "*".join(scale) or "1", "+".join(rise) or "0"


def typing_units(text):
    """What a typewriter shows one at a time: characters, or words for a long text."""
    return list(text) if len(text) <= 80 else re.findall(r"\S+\s*|\s+", text)


def clean_clip(c):
    clip = {"id": int(c["id"]), "track": int(c["track"]),
            "start": num(c["start"], 0, 1e6), "in": num(c["in"], 0, 1e6), "out": num(c["out"], 0, 1e6),
            "fadeIn": num(c.get("fadeIn", 0), 0, 30), "fadeOut": num(c.get("fadeOut", 0), 0, 30)}
    if c.get("kind") == "text":
        # Text goes into ffmpeg through a file, never the filter graph, so any characters are fine.
        return {**clip, "kind": "text", "src": "", "text": str(c.get("text", ""))[:MAX_TEXT],
                "x": num(c.get("x", 0.5), -0.5, 1.5), "y": num(c.get("y", 0.85), -0.5, 1.5),
                "tsize": num(c.get("tsize", 0.07), 0.01, 0.5),
                "color": c["color"] if COLOR.fullmatch(str(c.get("color", ""))) else "#ffffff",
                "bg": bool(c.get("bg", True)), "bold": bool(c.get("bold", True)),
                # only an installed family, so the name can't smuggle anything into fc-match
                "font": c["font"] if c.get("font") in fonts() else "",
                # the look: an outline, a shadow and a glow (shares of the font size), the box's colour
                "outline": num(c.get("outline", 0), 0, 0.25), "outlineColor": colour(c.get("outlineColor"), "#000000"),
                "shadow": num(c.get("shadow", 0), 0, 0.25), "shadowColor": colour(c.get("shadowColor"), "#000000"),
                "glow": num(c.get("glow", 0), 0, 1), "glowColor": colour(c.get("glowColor"), "#ffffff"),
                "boxColor": colour(c.get("boxColor"), "#000000"), "boxOpacity": num(c.get("boxOpacity", 0.55), 0, 1),
                "align": c["align"] if c.get("align") in ("L", "C", "R") else "C",
                # how it comes in and goes out, over fadeIn and fadeOut seconds
                "animIn": c["animIn"] if c.get("animIn") in ANIM_IN else "fade",
                "animOut": c["animOut"] if c.get("animOut") in ANIM_OUT else "fade"}
    return {**clip, "src": str(c["src"]),
            "layout": c.get("layout") if c.get("layout") in LAYOUTS else "full",
            "size": num(c.get("size", 0.3), 0.05, 1), "volume": num(c.get("volume", 1), 0, 4),
            "box": clean_box(c.get("box")), "fit": "fill" if c.get("fit") == "fill" else "fit",
            # a full-screen picture that doesn't fill the canvas: black bars or a blurred copy of itself
            "bars": "blur" if c.get("bars") == "blur" else "black",
            "crop": clean_crop(c.get("crop")), "rotate": int(num(c.get("rotate", 0), 0, 270)) // 90 * 90,
            # the sound of a video, detached onto its own clip: it adds sound only
            "audioOnly": bool(c.get("audioOnly"))}


_fonts = None
_font_files = {}
# Not for titles: emoji, icon and symbol fonts, and the regional copies of the CJK fonts.
NOT_TEXT_FONTS = re.compile(r"emoji|awesome|symbol|icons?\b|music|dingbat|cursor|math|CJK|D050000L", re.I)


def fonts():
    """Installed font families that can write English, for the text tools. Sorted."""
    global _fonts
    if _fonts is None:
        try:
            out = subprocess.run(["fc-list", ":lang=en", "family"], capture_output=True, text=True, timeout=10).stdout
            names = {line.split(",")[0].strip() for line in out.splitlines()}
            _fonts = sorted((n for n in names if n and not NOT_TEXT_FONTS.search(n)), key=str.lower)
        except (OSError, subprocess.TimeoutExpired):
            _fonts = []
    return _fonts


def font_file(family="", bold=True):
    """The font file fontconfig picks for a family (the default sans-serif when empty)."""
    key = (family, bold)
    if key not in _font_files:
        # fontconfig patterns treat \ - : , specially; escape them in the family name
        name = re.sub(r"([\\\-:,])", r"\\\1", family) if family else "sans-serif"
        _font_files[key] = None
        try:
            out = subprocess.run(["fc-match", f"{name}:{'bold' if bold else 'regular'}", "--format", "%{family[0]}|%{file}"],
                                 capture_output=True, text=True, timeout=5).stdout
            found, file = out.split("|", 1)
            if found and Path(file).is_file() and "'" not in file:
                _font_files[key] = {"family": found, "file": file}
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
    return _font_files[key]


def text_font():
    """The default text font: the desktop's bold sans-serif. {"family", "file"} or None."""
    return font_file("", True)


def clean_project(p):
    """What the export reads from a project, every value checked: these end up in a file
    name and in ffmpeg's filter graph, and the project comes in over HTTP."""
    try:
        canvas = p["canvas"]
        return {
            "name": safe_name(p.get("name", "")) or "project",
            "canvas": {"w": int(num(canvas["w"], 16, 8192)), "h": int(num(canvas["h"], 16, 8192)),
                       "fps": round(num(canvas.get("fps") or 30, 1, 240), 3)},
            "sources": [{"id": str(src["id"])} for src in p.get("sources", [])],
            "tracks": [{"id": int(t["id"]), "hidden": bool(t.get("hidden")), "muted": bool(t.get("muted"))}
                       for t in p["tracks"]],
            "clips": [clean_clip(c) for c in p["clips"]],
        }
    except (KeyError, TypeError, ValueError, AttributeError) as e:
        raise ValueError("This project can't be exported: its data is damaged") from e


def project_path(file):
    """The project file the page means, only ever looked up inside PROJECTS: just the
    file name is taken from the request, and the result must still be inside it."""
    root = os.path.realpath(PROJECTS)
    path = os.path.realpath(os.path.join(root, os.path.basename(str(file))))
    if not path.startswith(root + os.sep) or not path.endswith(".json"):
        raise ValueError("Unknown project")
    return Path(path)


def source_id(path):
    return hashlib.sha1(str(path).encode(), usedforsecurity=False).hexdigest()[:12]   # an id, not security


class Source:
    """One video file: probe info plus thumbnail strip and waveform, made in the background."""

    def __init__(self, path):
        self.path = Path(path)
        self.id = source_id(self.path)
        self.info = probe(self.path)
        key = hashlib.sha1(f"{self.path}:{self.path.stat().st_mtime}".encode(), usedforsecurity=False).hexdigest()[:16]
        self.cache = CACHE / key
        self.cache.mkdir(parents=True, exist_ok=True)
        self.thumbs = max(1, min(400, math.ceil(self.info["duration"] / 2)))
        self.thumb_w = round(THUMB_H * self.info["width"] / max(1, self.info["height"])) or 128
        self.has_video = self.info["video"]
        self.sprite = self.cache / "sprite-grid.jpg"
        self.cols = min(SPRITE_COLS, self.thumbs)
        self.peaks = self.cache / "peaks.json"
        self.proxy = self.cache / ("proxy.webm" if self.info.get("image") else "proxy.mp4")
        self.proxy_progress = 1.0 if self.proxy.exists() else 0.0
        if self.has_video:                     # an audio file has no picture to thumbnail or shrink
            threading.Thread(target=self.make_sprite, daemon=True).start()
            threading.Thread(target=self.make_proxy, daemon=True).start()
        else:
            self.proxy_progress = 1.0
        threading.Thread(target=self.make_peaks, daemon=True).start()

    def public(self):
        return {"id": self.id, "path": str(self.path), "name": self.path.name, **self.info,
                "thumbs": self.thumbs, "thumbW": self.thumb_w, "thumbH": THUMB_H,
                "spriteReady": self.sprite.exists() or not self.has_video, "spriteCols": self.cols,
                "peaksReady": self.peaks.exists() or not self.info["audio"],
                "proxyReady": self.proxy.exists() or not self.has_video, "proxyProgress": round(self.proxy_progress, 3)}

    def media(self):
        return self.proxy if self.proxy.exists() else self.path

    # A small, keyframe-dense H.264 copy: seeks instantly and decodes cheaply.
    # Made on the GPU (VA-API) when possible, so it doesn't heat up the CPU.
    def make_proxy(self):
        if self.proxy.exists():
            return
        if self.info.get("image"):
            return self.make_picture_proxy()
        tmp = self.proxy.with_suffix(".tmp.mp4")
        audio = ["-c:a", "aac", "-b:a", "128k"] if self.info["audio"] else ["-an"]
        tail = ["-r", "30", "-g", "15", *audio, "-movflags", "+faststart",
                "-progress", "pipe:1", "-nostats", str(tmp)]
        gpu = ["ffmpeg", "-v", "error", "-y", "-hwaccel", "vaapi", "-hwaccel_output_format", "vaapi",
               "-i", str(self.path), "-vf", f"scale_vaapi=w=-2:h={PROXY_H}:format=nv12",
               "-c:v", "h264_vaapi", "-qp", "26", *tail]
        cpu = ["ffmpeg", "-v", "error", "-y", "-i", str(self.path),
               "-vf", f"scale=-2:{PROXY_H},format=yuv420p", "-c:v", "libx264",
               "-preset", "ultrafast", "-crf", "26", "-threads", "4", *tail]
        hdr = ["ffmpeg", "-v", "error", "-y", "-i", str(self.path),
               "-vf", f"{tonemap()},scale=-2:{PROXY_H}", "-c:v", "libx264",
               "-preset", "ultrafast", "-crf", "26", "-threads", "4", *tail]
        for cmd in ((hdr, cpu) if self.info.get("hdr") else (gpu, cpu)):
            proc = subprocess.Popen(["nice", "-n", "10", *cmd], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True)
            for line in proc.stdout:
                if m := re.match(r"out_time_us=(\d+)", line):
                    self.proxy_progress = min(0.99, int(m.group(1)) / 1e6 / self.info["duration"])
            if proc.wait() == 0 and tmp.exists():
                tmp.rename(self.proxy)
                self.proxy_progress = 1.0
                return
            tmp.unlink(missing_ok=True)
            self.proxy_progress = 0.0

    # A picture becomes a short VP9 WebM: the browser plays it like a video (looping it), and it
    # keeps transparency, so a sticker shows what's under it. A still is one second long.
    def make_picture_proxy(self):
        tmp = self.proxy.with_suffix(".tmp.webm")
        src = (["-loop", "1", "-framerate", "30", "-t", "1"] if self.info["still"] else []) + ["-i", str(self.path)]
        size = f"scale=-2:'trunc(min({PROXY_H},ih)/2)*2'"
        for codec in (["-c:v", "libvpx-vp9", "-pix_fmt", "yuva420p", "-crf", "32", "-b:v", "0",
                       "-deadline", "realtime", "-cpu-used", "8", "-auto-alt-ref", "0"],
                      ["-c:v", "libvpx", "-pix_fmt", "yuva420p", "-crf", "20", "-b:v", "1M", "-auto-alt-ref", "0"]):
            subprocess.run(["nice", "-n", "10", "ffmpeg", "-v", "error", "-y", *src, "-an", "-vf",
                            f"{size},format=yuva420p", *codec, "-g", "15", "-f", "webm", str(tmp)],
                           stderr=subprocess.DEVNULL)
            if tmp.exists() and tmp.stat().st_size:
                tmp.rename(self.proxy)
                self.proxy_progress = 1.0
                return
            tmp.unlink(missing_ok=True)

    # Keyframes only (-skip_frame nokey): a long recording is skimmed in seconds.
    # A short clip may have a single keyframe, which leaves nothing to tile: then
    # decode every frame instead.
    def make_sprite(self):
        if self.sprite.exists():
            return
        tmp = self.sprite.with_suffix(".tmp.jpg")
        fps = self.thumbs / self.info["duration"]
        rows = math.ceil(self.thumbs / self.cols)
        vf = f"fps={fps:.6f},scale={self.thumb_w}:{THUMB_H},tile={self.cols}x{rows}"
        for skip in (["-skip_frame", "nokey"], []):
            subprocess.run(["nice", "-n", "10", "ffmpeg", "-v", "error", "-y", *skip, "-i", str(self.path),
                            "-an", "-vf", vf, "-frames:v", "1", "-q:v", "5", str(tmp)],
                           stderr=subprocess.DEVNULL)
            if tmp.exists() and tmp.stat().st_size:
                tmp.rename(self.sprite)
                return
            tmp.unlink(missing_ok=True)

    # Peak level per 50 ms: enough to see the pauses between sentences.
    def make_peaks(self):
        if self.peaks.exists() or not self.info["audio"]:
            return
        rate, step = 8000, 400
        proc = subprocess.Popen(
            ["nice", "-n", "10", "ffmpeg", "-v", "error", "-i", str(self.path),
             "-vn", "-ac", "1", "-ar", str(rate), "-f", "s16le", "-"],
            stdout=subprocess.PIPE)
        peaks = []
        while chunk := proc.stdout.read(step * 2):
            vals = memoryview(chunk[: len(chunk) // 2 * 2]).cast("h")
            peaks.append(max((abs(v) for v in vals), default=0) / 32768)
        proc.wait()
        top = max(peaks, default=1) or 1
        tmp = self.peaks.with_suffix(".tmp")
        tmp.write_text(json.dumps({"step": step / rate, "peaks": [round(p / top, 3) for p in peaks]}))
        tmp.replace(self.peaks)


class App:
    def __init__(self):
        PROJECTS.mkdir(parents=True, exist_ok=True)
        self.sources = {}
        self.project_file = None
        self.export = {"state": "idle", "progress": 0.0, "output": "", "error": ""}
        self.export_proc = None
        self.last_beat = time.time()
        self.lock = threading.Lock()
        # Any program on this computer can reach 127.0.0.1, including other users' ones. The
        # window proves it's ours with a cookie, handed out once for the key in its start URL.
        self.session = secrets.token_urlsafe(32)
        self.launch_key = secrets.token_urlsafe(32)

    def busy(self):
        return self.export["state"] == "running"

    def source(self, path):
        path = Path(path).expanduser().resolve()
        sid = source_id(path)
        if sid not in self.sources:
            if not path.is_file() or path.suffix.lower() not in VIDEO_EXT | AUDIO_EXT | IMAGE_EXT:
                raise ValueError(f"Not a video, audio or picture file: {path.name}")
            self.sources[sid] = Source(path)
        return self.sources[sid]

    # ---- projects ----
    def new_project(self, video):
        src = self.source(video)
        if not src.info["video"] or src.info.get("image"):
            raise ValueError("Start a project from a video, then add music, voiceovers or pictures to it")
        base = safe_name(src.path.stem) or "project"
        name, n = base, 2
        while (PROJECTS / f"{name}.json").exists():
            name, n = f"{base} {n}", n + 1
        info = src.info
        project = {
            "version": 2, "name": name, "created": time.strftime("%Y-%m-%d %H:%M"),
            "canvas": {"w": info["width"] // 2 * 2, "h": info["height"] // 2 * 2,
                       "fps": min(60, info["fps"] or 30)},
            "sources": [{"id": src.id, "path": str(src.path)}],
            "tracks": [{"id": 1, "name": "V1", "hidden": False, "muted": False},
                       {"id": 2, "name": "V2", "hidden": False, "muted": False}],
            "clips": [{"id": 1, "src": src.id, "track": 1, "start": 0.0,
                       "in": 0.0, "out": info["duration"], "layout": "full", "size": 0.3}],
        }
        self.project_file = PROJECTS / f"{name}.json"
        self.save(project)

    def open_project(self, file):
        file = project_path(file)
        if not file.is_file():
            raise ValueError("Unknown project")
        project = json.loads(file.read_text())
        for s in project.get("sources", []):
            try:
                self.source(s["path"])
            except (ValueError, OSError, subprocess.CalledProcessError):
                pass                                   # missing file: its clips show as offline
        self.project_file = file

    def rename(self, file, new_name):
        """Rename a project: its name inside and its file. Returns the new name."""
        file = project_path(file)
        if not file.is_file():
            raise ValueError("Unknown project")
        name = safe_name(new_name)
        if not name:
            raise ValueError("Give the project a name")
        target = PROJECTS / f"{name}.json"
        if target.exists() and target.resolve() != file:
            raise ValueError(f'A project called "{name}" already exists')
        project = json.loads(file.read_text())
        project["name"] = name
        tmp = target.with_suffix(".tmp")
        tmp.write_text(json.dumps(project, indent=1))
        tmp.replace(target)
        if target.resolve() != file:
            file.unlink()
        if self.project_file and self.project_file.resolve() == file:
            self.project_file = target
        return name

    def load(self):
        return json.loads(self.project_file.read_text())

    def save(self, project):
        tmp = self.project_file.with_suffix(".tmp")
        tmp.write_text(json.dumps(project, indent=1))
        tmp.replace(self.project_file)

    def list_projects(self):
        out = []
        for f in sorted(PROJECTS.glob("*.json"), key=lambda f: f.stat().st_mtime, reverse=True):
            try:
                p = json.loads(f.read_text())
            except (OSError, json.JSONDecodeError):
                continue
            out.append({"file": str(f), "name": p.get("name", f.stem),
                        "modified": time.strftime("%Y-%m-%d %H:%M", time.localtime(f.stat().st_mtime)),
                        "clips": len(p.get("clips", [])), "videos": len(p.get("sources", []))})
        return out

    # ---- export ----
    def start_export(self, project, height=None, preset=None, loudness=False):
        with self.lock:
            if self.busy():
                return
            try:
                steps, out, work = self.build_export(project, height, preset, loudness)
            except ValueError as e:
                self.export = {"state": "error", "progress": 0, "output": "", "error": str(e)}
                return
            self.export = job = {"state": "running", "progress": 0.0, "output": str(out), "error": ""}
        threading.Thread(target=self.run_export, args=(job, steps, out, work), daemon=True).start()

    def build_export(self, project, height=None, preset=None, loudness=False):
        """The export as a list of ffmpeg runs: the picture in pieces, then the sound, then the
        pieces joined with the sound. One run for the whole timeline would open every clip's
        video at once, and a long 4K edit then needs more memory than the computer has."""
        project = clean_project(project)
        W, H = project["canvas"]["w"] // 2 * 2, project["canvas"]["h"] // 2 * 2
        FPS = project["canvas"].get("fps") or 30
        # A smaller export is built at its own size from the start, not shrunk at the end:
        # every clip, box and text is placed in shares of the canvas, so it all scales along.
        preset = EXPORT_PRESETS.get(preset) or {}
        height = preset.get("height", height)
        gif = "fps" in preset
        smaller = (height in EXPORT_HEIGHTS or bool(preset)) and H > height
        if smaller:
            W, H = round(W * height / H / 2) * 2, height
        tracks = {t["id"]: t for t in project["tracks"]}
        order = [t["id"] for t in project["tracks"]]             # bottom → top
        clips = [c for c in project["clips"]
                 if c["track"] in tracks and not tracks[c["track"]].get("hidden")
                 and c["src"] in self.sources and c["out"] - c["in"] > 0.04]
        texts = [c for c in project["clips"] if c.get("kind") == "text" and c["track"] in tracks
                 and not tracks[c["track"]].get("hidden") and c["text"].strip() and c["out"] - c["in"] > 0.04]
        if not clips:
            raise ValueError("Nothing to export: the timeline is empty.")
        clips.sort(key=lambda c: (order.index(c["track"]), c["start"]))

        # Snap every clip to whole frames, and cut video AND audio to exactly that many
        # frames. Otherwise each joined clip is rounded a little differently and over many
        # cuts the picture drifts away from the sound.
        frames = lambda x: int(round(x * FPS))
        has_video = lambda c: self.sources[c["src"]].info.get("video", True) and not c["audioOnly"]
        full = lambda c: c.get("layout", "full") == "full"
        pictures = [c for c in clips if has_video(c)]       # music and voiceovers only add sound
        picture_ids = {id(c) for c in pictures}
        is_picture = lambda c: id(c) in picture_ids
        sf, nf, cursor = {}, {}, {}
        for c in sorted(clips + texts, key=lambda c: c["start"]):
            i = id(c)
            nf[i] = max(1, frames(c["out"] - c["in"]))
            sf[i] = frames(c["start"])
            if is_picture(c) and full(c):          # full-frame clips on a track join into one strip
                sf[i] = max(sf[i], cursor.get(c["track"], 0))
                cursor[c["track"]] = sf[i] + nf[i]
        total_f = max(sf[id(c)] + nf[id(c)] for c in clips + texts)
        total = total_f / FPS
        first_id = project["sources"][0]["id"] if project.get("sources") else clips[0]["src"]
        first = self.sources.get(first_id) or self.sources[clips[0]["src"]]
        out = self.output_path(first.path.parent, project["name"], f"-{H}p" if smaller else "",
                               ".gif" if gif else ".mp4")
        shutil.rmtree(CACHE / "export", ignore_errors=True)   # what earlier exports left behind
        work = CACHE / "export" / secrets.token_hex(4)
        work.mkdir(parents=True)
        # ffmpeg reads the text files and the list of pieces from here, inside quotes
        if "'" in str(work):
            raise ValueError("Can't export: the cache folder's path contains a quote")
        head = ["ffmpeg", "-v", "error", "-y", "-progress", "pipe:1", "-nostats"]

        # Cut the timeline into pieces, one per run of clips that overlap in time, so each
        # ffmpeg run only opens the videos it shows together. Every open 4K decoder holds about
        # a gigabyte of frames, whether or not its clip is on screen yet. A gap belongs to the
        # piece after it, and the last piece runs to the end.
        pieces = []                                # [first frame, end frame, clips and texts]
        for c in sorted(pictures + texts, key=lambda c: sf[id(c)]):
            s, e = sf[id(c)], sf[id(c)] + nf[id(c)]
            if pieces and s < pieces[-1][1]:
                pieces[-1][1] = max(pieces[-1][1], e)
                pieces[-1][2].append(c)
            else:
                pieces.append([pieces[-1][1] if pieces else 0, e, [c]])
        if not pieces:
            pieces = [[0, total_f, []]]
        pieces[-1][1] = total_f

        def box_px(c):
            """A clip's box in pixels: x, y, width, height (even sizes, as yuv420p needs)."""
            layout = c.get("layout", "full")
            if layout == "full":
                return 0, 0, W, H
            if layout == "free":
                b = c["box"]
                return (round(W * b["x"]), round(H * b["y"]),
                        max(16, round(W * b["w"]) // 2 * 2), max(16, round(H * b["h"]) // 2 * 2))
            size = float(c.get("size", 0.3))
            return 0, 0, max(16, round(W * size) // 2 * 2), max(16, round(H * size) // 2 * 2)

        def video(k, c, pad_full):
            _, _, bw, bh = box_px(c)
            info = self.sources[c["src"]].info
            # a sticker keeps its transparent pixels on an overlay; on the bottom strip it sits on black
            alpha = info.get("alpha") and not pad_full
            color = (tonemap() if info.get("hdr") else
                     "format=yuva420p" if alpha else f"format=yuv420p,{SDR_TAGS}")
            if c.get("layout") in ("free", "full") and c.get("fit") == "fill":
                # cover the box, cropping the overflow evenly from both sides
                size = f"scale={bw}:{bh}:force_original_aspect_ratio=increase,crop={bw}:{bh}"
            else:
                size = f"scale={bw}:{bh}:force_original_aspect_ratio=decrease,scale=trunc(iw/2)*2:trunc(ih/2)*2"
            # crop the picture's edges, then turn it, before it is fitted into its box
            cr, shape = c["crop"], ""
            if any(cr.values()):
                shape += (f"crop=trunc(iw*{1 - cr['l'] - cr['r']:.4f}/2)*2:trunc(ih*{1 - cr['t'] - cr['b']:.4f}/2)*2:"
                          f"trunc(iw*{cr['l']:.4f}):trunc(ih*{cr['t']:.4f}),")
            shape += {90: "transpose=1,", 180: "hflip,vflip,", 270: "transpose=2,"}.get(c["rotate"], "")
            f = f"[{k}:v:0]fps={FPS},{color},{shape}"
            if full(c) and c["fit"] == "fit" and c["bars"] == "blur":
                # the bars become a blurred copy of the picture, filling the canvas behind it;
                # blurred small and scaled up, so it costs next to nothing at 4K
                bw8, bh8 = max(16, W // 8 // 2 * 2), max(16, H // 8 // 2 * 2)
                f += (f"split[bg{k}][fg{k}];[bg{k}]scale={bw8}:{bh8}:force_original_aspect_ratio=increase,"
                      f"crop={bw8}:{bh8},boxblur=6:2,scale={W}:{H},format=yuv420p[bb{k}];"
                      f"[fg{k}]{size}[ff{k}];[bb{k}][ff{k}]overlay=(W-w)/2:(H-h)/2")
            else:
                f += size
                if pad_full and full(c):
                    f += f",pad={W}:{H}:(ow-iw)/2:(oh-ih)/2:black"
            # exactly n frames: hold the last frame if the source runs short, then cut
            return (f + f",setsar=1,format={'yuva420p' if alpha else 'yuv420p'},setpts=PTS-STARTPTS,"
                        f"tpad=stop_mode=clone:stop_duration={3 / FPS:.4f},trim=end_frame={nf[id(c)]}")

        m = CORNER_MARGIN
        pos = {"full": ("(W-w)/2", "(H-h)/2"), "tl": (f"W*{m}", f"W*{m}"),
               "tr": (f"W-w-W*{m}", f"W*{m}"), "bl": (f"W*{m}", f"H-h-W*{m}"),
               "br": (f"W-w-W*{m}", f"H-h-W*{m}")}

        def piece(p, a, b, members, file):
            """The picture from frame a to frame b, with only this piece's clips opened."""
            vclips = sorted((c for c in members if is_picture(c)), key=lambda c: (order.index(c["track"]), c["start"]))
            vtexts = sorted((c for c in members if not is_picture(c)), key=lambda c: (order.index(c["track"]), c["start"]))
            args, graph = head + (VAAPI_DEVICE if gpu else []), []
            for c in vclips:                       # a little extra input, trimmed exactly below
                info, length = self.sources[c["src"]].info, f"{nf[id(c)] / FPS + 0.25:.4f}"
                if info.get("still"):              # a photo or sticker: the one picture, over and over
                    args += ["-loop", "1", "-framerate", str(FPS), "-t", length]
                elif info.get("loop"):             # an animated GIF/WebP plays round and round
                    args += ["-stream_loop", "-1", "-ss", f"{c['in'] % max(info['duration'], 0.01):.4f}", "-t", length]
                else:
                    args += ["-ss", f"{c['in']:.4f}", "-t", length]
                args += ["-i", str(self.sources[c["src"]].path)]

            def black(label, n):
                graph.append(f"color=black:s={W}x{H}:r={FPS}:d={(n + 2) / FPS:.4f},format=yuv420p,{SDR_TAGS},"
                             f"trim=end_frame={n},setpts=PTS-STARTPTS[{label}]")

            # Bottom visible track: one concat with black gaps (cheap).
            base = [c for c in vclips if c["track"] == vclips[0]["track"] and full(c)] if vclips else []
            segs, at, n = [], a, 0
            for c in base:
                k = vclips.index(c)
                if sf[id(c)] > at:
                    black(f"g{n}", sf[id(c)] - at)
                    segs.append(f"[g{n}]")
                    n += 1
                graph.append(video(k, c, True) + f",setpts=PTS-STARTPTS[s{k}]")
                segs.append(f"[s{k}]")
                at = sf[id(c)] + nf[id(c)]
            if b > at:
                black(f"g{n}", b - at)
                segs.append(f"[g{n}]")
            # re-time by frame number: the joined strip is exactly sum(n) frames, so frame N sits at N/FPS
            graph.append(f"{''.join(segs)}concat=n={len(segs)}:v=1:a=0,setpts=N/({FPS}*TB)[b0]")

            # Everything else is overlaid on top, in track order.
            layer = 0
            for k, c in enumerate(vclips):
                if c in base:
                    continue
                st, en = (sf[id(c)] - a) / FPS, (sf[id(c)] + nf[id(c)] - a) / FPS
                if c.get("layout") == "free":          # centred in its box (a filled clip is the box)
                    bx, by, bw, bh = box_px(c)
                    x, y = f"{bx}+({bw}-w)/2", f"{by}+({bh}-h)/2"
                else:
                    x, y = pos.get(c.get("layout", "full"), pos["full"])
                graph.append(video(k, c, False) + f",setpts=PTS-STARTPTS+{st:.4f}/TB[o{k}]")
                graph.append(f"[b{layer}][o{k}]overlay=x={x}:y={y}:eof_action=pass:"
                             f"enable='between(t,{st:.4f},{en - 0.5 / FPS:.4f})'[b{layer + 1}]")
                layer += 1
            # Titles and captions on top of everything, in track order. The text reaches ffmpeg
            # through a file (textfile, expansion=none), so nothing typed can change the graph.
            def drawtexts(c, files, font, st, en, h, glow=False):
                """drawtext filters for one title on a frame h pixels high, from st to en seconds.
                A typewriter is one drawtext per step, each with a longer start of the text."""
                size = h * c["tsize"]
                alpha, scale, rise = text_motion(c, st, en)
                x = {"L": f"w*{c['x']:.4f}", "C": f"w*{c['x']:.4f}-text_w/2", "R": f"w*{c['x']:.4f}-text_w"}[c["align"]]
                look = (f"fontfile='{font}':expansion=none:fontsize='max(1,{c['tsize']:.4f}*h*{scale})':"
                        f"text_align={c['align']}:x='{x}':y='h*({c['y']:.4f}+{rise})-text_h/2':alpha='{alpha}'")
                if glow:                               # the glow is a thick outline in one colour, blurred later
                    g = f"0x{c['glowColor'][1:]}"
                    look += f":fontcolor={g}:borderw={max(1, round(size * c['glow'] * 0.25))}:bordercolor={g}"
                else:
                    look += f":fontcolor=0x{c['color'][1:]}"
                    if c["outline"]:
                        look += f":borderw={max(1, round(size * c['outline']))}:bordercolor=0x{c['outlineColor'][1:]}"
                    if c["shadow"]:
                        s = max(1, round(size * c["shadow"]))
                        look += f":shadowx={s}:shadowy={s}:shadowcolor=0x{c['shadowColor'][1:]}@0.7"
                    if c["bg"]:
                        look += (f":box=1:boxcolor=0x{c['boxColor'][1:]}@{c['boxOpacity']:.2f}"
                                 f":boxborderw={max(2, round(size * 0.3))}")
                last = en - 0.5 / FPS
                if len(files) == 1:
                    return [f"drawtext={look}:textfile='{files[0]}':enable='between(t,{st:.4f},{last:.4f})'"]
                di = min(c["fadeIn"], (en - st) / 2)
                steps = len(files)
                return [f"drawtext={look}:textfile='{file}':enable='gte(t,{st + di * k / steps:.4f})*"
                        + (f"lt(t,{st + di * (k + 1) / steps:.4f})'" if k < steps - 1 else f"lte(t,{last:.4f})'")
                        for k, file in enumerate(files)]

            for n, c in enumerate(vtexts):
                st, en = (sf[id(c)] - a) / FPS, (sf[id(c)] + nf[id(c)] - a) / FPS
                font = font_file(c["font"], c["bold"])
                if not font:
                    raise ValueError("Can't draw text: no font found (fontconfig's fc-match is missing)")
                if c["animIn"] == "type" and c["fadeIn"] > 0 and c["text"]:
                    units = typing_units(c["text"])
                    steps_text = ["".join(units[:k + 1]) for k in range(len(units))]
                else:
                    steps_text = [c["text"]]
                files = []
                for k, words in enumerate(steps_text):
                    textfile = work / f"{p}-{n}-{k}.txt"
                    textfile.write_text(words)
                    files.append(textfile)
                if c["glow"]:
                    # Glow: the text drawn thick in the glow colour on a clear quarter-size layer,
                    # blurred, scaled up and laid under the text. Small, so it's quick even at 4K.
                    gw, gh = max(16, W // 4 // 2 * 2), max(16, H // 4 // 2 * 2)
                    sigma = max(1.0, gh * c["tsize"] * c["glow"] * 0.3)
                    graph.append(f"color=c=black@0:s={gw}x{gh}:r={FPS}:d={en - st + 2 / FPS:.4f},format=rgba,"
                                 + ",".join(drawtexts(c, files, font["file"], 0, en - st, gh, glow=True))
                                 + f",gblur=sigma={sigma:.2f},scale={W}:{H},setpts=PTS+{st:.4f}/TB[gl{n}]")
                    graph.append(f"[b{layer}][gl{n}]overlay=format=auto:eof_action=pass[b{layer + 1}]")
                    layer += 1
                graph.append(f"[b{layer}]" + ",".join(drawtexts(c, files, font["file"], st, en, H)) + f"[b{layer + 1}]")
                layer += 1
            graph.append(f"[b{layer}]format=yuv420p,{SDR_TAGS},trim=end_frame={b - a}"
                         + (",format=nv12,hwupload" if gpu else "") + "[vout]")
            # Every piece is encoded the same way, so they can be joined without encoding again.
            encode = (["-c:v", "h264_vaapi", "-qp", str(preset.get("qp", 21))] if gpu else
                      ["-c:v", "libx264", "-preset", "fast", "-crf", str(preset.get("crf", 20))])
            return args + ["-filter_complex", ";".join(graph), "-map", "[vout]", *encode, "-r", str(FPS),
                           "-colorspace", "bt709", "-color_primaries", "bt709", "-color_trc", "bt709",
                           "-color_range", "tv", "-threads", "6", "-frames:v", str(b - a), "-f", "mpegts", str(file)]

        gpu = gpu_encoder()
        steps = []
        for p, (a, b, members) in enumerate(pieces):
            file = work / f"{p}.ts"
            steps.append({"args": piece(p, a, b, members, file), "length": (b - a) / FPS, "weight": (b - a) / FPS})
        (work / "pieces.txt").write_text("".join(f"file '{work / f'{p}.ts'}'\n" for p in range(len(pieces))))

        # The sound: every clip on an unmuted track, cut to the same frames, placed and mixed.
        # Only the sound of each file is read, so this run stays light however many clips there are.
        args, graph, audio = list(head), [], []
        for c in clips:
            gain = float(c.get("volume", 1))
            if tracks[c["track"]].get("muted") or gain <= 0 or not self.sources[c["src"]].info["audio"]:
                continue
            k = len(audio)
            args += ["-vn", "-ss", f"{c['in']:.4f}", "-t", f"{nf[id(c)] / FPS + 0.25:.4f}",
                     "-i", str(self.sources[c["src"]].path)]
            d = nf[id(c)] / FPS
            fade = min(0.02, d / 4)                     # always a tiny fade: no clicks at the cuts
            fin, fout = max(fade, min(c.get("fadeIn", 0), d / 2)), max(fade, min(c.get("fadeOut", 0), d / 2))
            ms = int(round(sf[id(c)] / FPS * 1000))
            # mono: copy to both sides at full level (a plain upmix would drop it by 3 dB)
            to_stereo = "pan=stereo|c0=c0|c1=c0" if self.sources[c["src"]].info.get("channels") == 1 \
                else "aformat=channel_layouts=stereo"
            graph.append(f"[{k}:a:0]aresample=48000,{to_stereo},asetpts=PTS-STARTPTS,"
                         f"apad=whole_dur={d:.4f},atrim=duration={d:.4f},"
                         f"volume={gain:.3f},afade=t=in:d={fin:.3f},afade=t=out:st={max(0, d - fout):.4f}:d={fout:.3f},"
                         f"adelay={ms}|{ms}[a{k}]")
            audio.append(f"[a{k}]")
        graph.append(f"anullsrc=r=48000:cl=stereo,atrim=0:{total:.4f}[asil]")
        graph.append(f"[asil]{''.join(audio)}amix=inputs={len(audio) + 1}:duration=first:normalize=0,"
                     f"alimiter=limit=0.97:attack=5:release=50:level=false[aout]")
        sound = work / "sound.m4a"
        aac = ["-c:a", "aac", "-b:a", preset.get("audio", "192k"), "-t", f"{total:.4f}", str(sound)]
        if gif:
            pass                                   # a GIF has no sound
        elif not loudness:
            steps.append({"args": args + ["-filter_complex", ";".join(graph), "-map", "[aout]", *aac],
                          "length": total, "weight": total / 20})
        else:
            # Loudness in two passes, as recommended: measure the whole mix, then turn it up or
            # down by one fixed amount, so nothing pumps. The second run is built from what the
            # first one measured.
            mix = work / "mix.wav"
            steps.append({"args": args + ["-filter_complex", ";".join(graph), "-map", "[aout]",
                                          "-t", f"{total:.4f}", str(mix)],
                          "length": total, "weight": total / 20})
            steps.append({"args": ["ffmpeg", "-hide_banner", "-nostats", "-progress", "pipe:1", "-i", str(mix),
                                   "-af", f"loudnorm={LOUDNESS}:print_format=json", "-f", "null", "-"],
                          "length": total, "weight": total / 40})
            steps.append({"args": lambda measured: head + ["-i", str(mix), "-af", louder(measured), *aac],
                          "length": total, "weight": total / 40})

        if gif:
            # A GIF from the joined pieces, with its own palette, so the colours stay right.
            steps.append({"args": head + ["-f", "concat", "-safe", "0", "-i", str(work / "pieces.txt"),
                                          "-vf", f"fps={preset['fps']},split[a][b];[a]palettegen=stats_mode=diff[p];"
                                                 "[b][p]paletteuse=dither=bayer:bayer_scale=4",
                                          "-t", f"{total:.4f}", str(out)],
                          "length": total, "weight": total / 10})
        else:
            # Join the pieces and add the sound, copying both as they are.
            steps.append({"args": head + ["-f", "concat", "-safe", "0", "-i", str(work / "pieces.txt"),
                                          "-i", str(sound), "-map", "0:v", "-map", "1:a", "-c", "copy",
                                          "-movflags", "+faststart", "-t", f"{total:.4f}", str(out)],
                          "length": total, "weight": total / 50})
        return steps, out, work

    @staticmethod
    def output_path(folder, name, size="", ext=".mp4"):
        base = folder / f"{name}-edit{size}{ext}"
        path, n = base, 2
        while path.exists():
            path = base.with_name(f"{base.stem}-{n}{ext}")
            n += 1
        return path

    # Each run only ever updates its own job: a cancelled run that is still winding down
    # must not touch the export started after it.
    def run_export(self, job, steps, out, work):
        done, whole, told = 0.0, sum(s["weight"] for s in steps), ""
        try:
            for step in steps:
                if job["state"] == "cancelled":
                    break
                args = step["args"](told) if callable(step["args"]) else step["args"]
                proc = subprocess.Popen(["nice", "-n", "5", *args], stdout=subprocess.PIPE,
                                        stderr=subprocess.PIPE, text=True)
                self.export_proc = proc
                err = []
                reader = threading.Thread(target=lambda p=proc, e=err: e.extend(p.stderr), daemon=True)
                reader.start()
                for line in proc.stdout:
                    m = re.match(r"out_time_us=(\d+)", line)
                    if m and step["length"]:
                        part = min(1.0, int(m.group(1)) / 1e6 / step["length"])
                        job["progress"] = min(0.999, (done + step["weight"] * part) / whole)
                code = proc.wait()
                reader.join(timeout=2)
                if self.export_proc is proc:
                    self.export_proc = None
                if code != 0:
                    if job["state"] != "cancelled":
                        job.update(state="error", error="".join(err).strip()[-800:] or f"ffmpeg exited {code}")
                    break
                done += step["weight"]
                told = "".join(err)                # what this run printed, for a step built from it
            else:
                if job["state"] != "cancelled":
                    job.update(state="done", progress=1.0)
        finally:
            shutil.rmtree(work, ignore_errors=True)
            if job["state"] != "done":
                out.unlink(missing_ok=True)

    def cancel_export(self):
        proc = self.export_proc
        if self.busy():
            self.export["state"] = "cancelled"
        if proc:
            proc.terminate()
            try:                                   # let it go before deleting its file, so the next
                proc.wait(timeout=10)              # export can't pick the same name while it's still open
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
            Path(self.export["output"]).unlink(missing_ok=True)


def home_label(path):
    """path with the home folder shown as ~, for the UI."""
    try:
        return "~/" + str(Path(path).relative_to(Path.home()))
    except ValueError:
        return str(path)


def list_videos(audio=False):
    """Videos in the videos folder, newest first; with audio=True also the music, voiceovers
    and pictures there, in ~/Music and in ~/Pictures, for adding to a project."""
    exts = VIDEO_EXT | AUDIO_EXT | IMAGE_EXT if audio else VIDEO_EXT
    roots = [VIDEOS] + [d for d in (MUSIC, PICTURES) if audio and d.is_dir() and d.resolve() != VIDEOS.resolve()]
    files = []
    for root in roots:
        for depth in ("*", "*/*", "*/*/*", "*/*/*/*"):    # subfolders too, e.g. an external drive
            files += [(root, f) for f in root.glob(depth) if f.suffix.lower() in exts
                      and not f.name.startswith(".") and f.is_file()]
    files.sort(key=lambda rf: rf[1].stat().st_mtime, reverse=True)
    return [{"path": str(f), "name": str(f.relative_to(root)) if root == VIDEOS else home_label(f),
             "audio": f.suffix.lower() in AUDIO_EXT, "image": f.suffix.lower() in IMAGE_EXT, "size": f.stat().st_size,
             "modified": time.strftime("%Y-%m-%d %H:%M", time.localtime(f.stat().st_mtime))}
            for root, f in files]


def media_kind(path):
    ext = Path(path).suffix.lower()
    return ("gif" if ext in (".gif", ".webp") else "image" if ext in IMAGE_EXT else
            "audio" if ext in AUDIO_EXT else "video" if ext in VIDEO_EXT else None)


def list_drawer():
    """The media drawer: what's newest in Downloads and in Cutline's own media folder."""
    files = []
    for root in (DOWNLOADS, MEDIA):
        if root.is_dir():
            files += [f for f in root.iterdir() if f.is_file() and not f.name.startswith(".") and media_kind(f)
                      and not f.name.endswith((".part", ".crdownload"))]       # still downloading
    files.sort(key=lambda f: f.stat().st_mtime, reverse=True)
    return [{"path": str(f), "name": f.name, "kind": media_kind(f), "mtime": f.stat().st_mtime,
             "size": f.stat().st_size, "where": home_label(f.parent)} for f in files[:60]]


def drawer_file(path):
    """A file the drawer may show a picture of: only from those two folders."""
    real = Path(os.path.realpath(str(path)))
    for root in (DOWNLOADS, MEDIA):
        if real.parent == Path(os.path.realpath(root)) and real.suffix.lower() in IMAGE_EXT and real.is_file():
            return real
    return None


def free_media_path(name):
    """Somewhere to keep a dropped or fetched file, under its own (cleaned) name."""
    MEDIA.mkdir(parents=True, exist_ok=True)
    stem, ext = safe_name(Path(name).stem) or "media", Path(name).suffix.lower()
    if not media_kind(f"x{ext}"):
        raise ValueError(f"Not a video, audio or picture file: {name}")
    path, n = MEDIA / f"{stem}{ext}", 2
    while path.exists():
        path, n = MEDIA / f"{stem}-{n}{ext}", n + 1
    return path


def public_host(host):
    """Only fetch from the internet: never this computer or the local network."""
    try:
        infos = socket.getaddrinfo(host, None)
    except OSError as e:
        raise ValueError(f"Can't find {host}") from e
    for info in infos:
        ip = ipaddress.ip_address(info[4][0])
        if not ip.is_global:
            raise ValueError("Only pictures and sounds from the internet can be fetched")


class _CheckedRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        parts = urllib.parse.urlsplit(newurl)
        if parts.scheme not in ("http", "https"):
            raise ValueError("Only web addresses can be fetched")
        public_host(parts.hostname or "")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


FETCH_TYPES = {"image/gif": ".gif", "image/webp": ".webp", "image/png": ".png", "image/jpeg": ".jpg",
               "video/mp4": ".mp4", "video/webm": ".webm", "audio/mpeg": ".mp3", "audio/wav": ".wav",
               "audio/x-wav": ".wav", "audio/ogg": ".ogg", "audio/mp4": ".m4a", "audio/aac": ".aac",
               "audio/flac": ".flac"}


def fetch_media(url):
    """A GIF, picture or sound dragged in from a web page: downloaded once into the media folder."""
    parts = urllib.parse.urlsplit(str(url).strip())
    if parts.scheme not in ("http", "https") or not parts.hostname:
        raise ValueError("Only web addresses can be fetched")
    public_host(parts.hostname)
    opener = urllib.request.build_opener(_CheckedRedirects())
    req = urllib.request.Request(parts.geturl(), headers={"User-Agent": f"Cutline/{VERSION}"})
    with opener.open(req, timeout=30) as resp:       # noqa: S310 - http(s) only, checked above
        ctype = (resp.headers.get_content_type() or "").lower()
        name = Path(urllib.parse.unquote(urllib.parse.urlsplit(resp.geturl()).path)).name or "media"
        if not media_kind(name):
            if ctype not in FETCH_TYPES:
                raise ValueError(f"That isn't a picture, a video or a sound ({ctype or 'unknown type'})")
            name = Path(name).stem + FETCH_TYPES[ctype]
        path = free_media_path(name)
        tmp = path.with_name(f".{path.name}.part")
        size = 0
        try:
            with open(tmp, "wb") as out:
                while chunk := resp.read(1 << 20):
                    size += len(chunk)
                    if size > MAX_FETCH:
                        raise ValueError("That file is too big to fetch (over 200 MB)")
                    out.write(chunk)
            tmp.replace(path)
        finally:
            tmp.unlink(missing_ok=True)
    return path


def handler_for(app: App):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send_json(self, obj, code=200):
            self.html = False
            body = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def end_headers(self):
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            if self.html:
                self.send_header("Content-Security-Policy", CSP)
            super().end_headers()

        html = False

        def send_file(self, path, ctype):
            self.html = ctype.startswith("text/html")
            size = path.stat().st_size
            start, end = 0, size - 1
            rng = self.headers.get("Range")
            if rng and (m := re.fullmatch(r"bytes=(\d*)-(\d*)", rng.strip())) and (m.group(1) or m.group(2)):
                if m.group(1):
                    start = int(m.group(1))
                    end = int(m.group(2)) if m.group(2) else size - 1
                else:
                    start = max(0, size - int(m.group(2)))
                end = min(end, size - 1)
                if start > end:
                    self.send_response(416)
                    self.send_header("Content-Range", f"bytes */{size}")
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                self.send_response(206)
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            else:
                self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Content-Length", str(end - start + 1))
            self.end_headers()
            try:
                with open(path, "rb") as f:
                    f.seek(start)
                    left = end - start + 1
                    while left > 0 and (chunk := f.read(min(1 << 20, left))):
                        self.wfile.write(chunk)
                        left -= len(chunk)
            except (BrokenPipeError, ConnectionResetError):
                pass

        def trusted(self):
            """Only our own page may talk to us: refuse other hosts (DNS rebinding) and,
            for POSTs, requests that other web pages send to this port."""
            port = self.server.server_address[1]
            host = self.headers.get("Host", "")
            if host not in (f"127.0.0.1:{port}", f"localhost:{port}"):
                return False
            origin = self.headers.get("Origin")
            if self.command != "GET" and origin is not None and origin != f"http://{host}":
                return False
            try:
                jar = SimpleCookie(self.headers.get("Cookie", ""))
            except CookieError:
                return False
            got = jar.get(self.cookie_name())
            return got is not None and hmac.compare_digest(got.value, app.session)

        def cookie_name(self):
            return f"cutline_{self.server.server_address[1]}"   # cookies ignore ports: one per server

        def launch(self):
            """The window's first request carries the one-time key: swap it for the session cookie."""
            key = re.search(r"[?&]key=([\w-]+)", self.path)
            if not key or not app.launch_key or not hmac.compare_digest(key.group(1), app.launch_key):
                return False
            app.launch_key = None
            self.send_response(303)
            self.send_header("Set-Cookie", f"{self.cookie_name()}={app.session}; Path=/; HttpOnly; SameSite=Strict")
            self.send_header("Location", "/")
            self.send_header("Content-Length", "0")
            self.end_headers()
            return True

        def do_GET(self):
            if self.path.startswith("/?") and self.launch():
                return None
            if not self.trusted():
                return self.send_json({"error": "forbidden: open Cutline from its launcher"}, 403)
            p = self.path.split("?")[0]
            if p == "/api/beat":
                app.last_beat = time.time()
                return self.send_json({"ok": True})
            if p == "/":
                page = "index.html" if app.project_file else "pick.html"
                return self.send_file(HERE / page, "text/html; charset=utf-8")
            if p == "/api/home":
                return self.send_json({"videos": list_videos(), "videosDir": home_label(VIDEOS),
                                       "projects": app.list_projects(), "theme": theme()})
            if p == "/api/theme":
                return self.send_json(theme())
            if p == "/api/videos":                    # the editor's picker: music and voiceovers too
                return self.send_json({"videos": list_videos(audio=True), "videosDir": home_label(VIDEOS)})
            if p == "/api/export":
                return self.send_json(app.export)
            if p == "/api/drawer":
                return self.send_json({"files": list_drawer(), "downloads": home_label(DOWNLOADS)})
            if p == "/api/thumb":
                q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
                file = drawer_file((q.get("path") or [""])[0])
                if not file:
                    return self.send_json({"error": "not found"}, 404)
                return self.send_file(file, IMAGE_TYPES[file.suffix.lower()])
            if m := re.match(r"/(media|sprite|peaks|api/source)/([0-9a-f]{12})", p):
                src = app.sources.get(m.group(2))
                if not src:
                    return self.send_json({"error": "unknown source"}, 404)
                kind = m.group(1)
                if kind == "media":
                    ctype = {".mov": "video/quicktime", ".mkv": "video/x-matroska", ".webm": "video/webm",
                             **AUDIO_TYPES}.get(src.path.suffix.lower(), "video/mp4")
                    media = src.media()
                    if media == src.path:
                        return self.send_file(media, ctype)
                    return self.send_file(media, "video/webm" if media.suffix == ".webm" else "video/mp4")
                if kind == "sprite" and src.sprite.exists():
                    return self.send_file(src.sprite, "image/jpeg")
                if kind == "peaks" and src.peaks.exists():
                    return self.send_file(src.peaks, "application/json")
                if kind == "api/source":
                    return self.send_json(src.public())
                return self.send_json({"error": "not ready"}, 404)
            if p == "/api/project":
                if not app.project_file:
                    return self.send_json({"error": "no project open"}, 404)
                return self.send_json({"project": app.load(), "theme": theme(),
                                       "textFont": (text_font() or {}).get("family", "sans-serif"),
                                       "fonts": fonts(),
                                       "sources": {sid: s.public() for sid, s in app.sources.items()},
                                       "export": app.export})
            self.send_json({"error": "not found"}, 404)

        def upload(self, n):
            """A file dropped on the window: the browser sends its bytes, never its path."""
            if not app.project_file:
                return self.send_json({"error": "no project open"}, 404)
            if not 0 < n <= MAX_UPLOAD:
                return self.send_json({"error": "That file is too big (over 2 GB)"}, 413)
            name = (urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query).get("name") or ["media"])[0]
            try:
                path = free_media_path(name)
            except ValueError as e:
                return self.send_json({"error": str(e)}, 400)
            tmp = path.with_name(f".{path.name}.part")
            try:
                with open(tmp, "wb") as out:
                    left = n
                    while left > 0 and (chunk := self.rfile.read(min(1 << 20, left))):
                        out.write(chunk)
                        left -= len(chunk)
                if left:
                    raise ValueError("The file didn't arrive whole")
                tmp.replace(path)
                return self.send_json(app.source(path).public())
            except (ValueError, OSError, subprocess.CalledProcessError) as e:
                path.unlink(missing_ok=True)
                return self.send_json({"error": str(e) or "Could not read that file"}, 400)
            finally:
                tmp.unlink(missing_ok=True)

        def do_POST(self):
            if not self.trusted():
                return self.send_json({"error": "forbidden"}, 403)
            try:
                n = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                n = -1
            if self.path.startswith("/api/upload?"):
                return self.upload(n)
            if not 0 <= n <= MAX_BODY:
                return self.send_json({"error": "bad request size"}, 413)
            try:
                body = json.loads(self.rfile.read(n) or b"null") or {}
            except (json.JSONDecodeError, UnicodeDecodeError):
                return self.send_json({"error": "bad json"}, 400)
            if not isinstance(body, dict):
                return self.send_json({"error": "bad json"}, 400)
            if self.path == "/api/bye":            # window closed or reloading
                app.last_beat = time.time() - IDLE_EXIT + CLOSE_GRACE
                return self.send_json({"ok": True})
            try:
                if self.path in ("/api/new", "/api/openproject", "/api/close") and app.busy():
                    return self.send_json({"error": "An export is still running"}, 409)
                if self.path == "/api/new":
                    app.new_project(body.get("path", ""))
                    return self.send_json({"ok": True})
                if self.path == "/api/openproject":
                    app.open_project(body.get("file", ""))
                    return self.send_json({"ok": True})
                if self.path == "/api/close":
                    app.project_file = None
                    return self.send_json({"ok": True})
                if self.path == "/api/renameproject":
                    return self.send_json({"ok": True, "name": app.rename(body.get("file", ""), body.get("name", ""))})
                if self.path == "/api/rename":
                    if not app.project_file:
                        return self.send_json({"error": "no project open"}, 404)
                    if app.busy():
                        return self.send_json({"error": "Wait for the export to finish"}, 409)
                    return self.send_json({"ok": True, "name": app.rename(app.project_file, body.get("name", ""))})
                if self.path == "/api/deleteproject":
                    f = project_path(body.get("file", ""))
                    if not app.project_file or f != app.project_file.resolve():   # never the open one
                        f.unlink(missing_ok=True)
                    return self.send_json({"ok": True})
                if not app.project_file:
                    return self.send_json({"error": "no project open"}, 404)
                if self.path == "/api/project":
                    app.save(body)
                    return self.send_json({"ok": True})
                if self.path == "/api/addsource":
                    return self.send_json(app.source(body.get("path", "")).public())
                if self.path == "/api/fetch":
                    return self.send_json(app.source(fetch_media(body.get("url", ""))).public())
                if self.path == "/api/openweb":
                    url = SITES.get(body.get("site"))
                    if not url:
                        return self.send_json({"error": "unknown site"}, 400)
                    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    return self.send_json({"ok": True, "url": url})
                if self.path == "/api/export":
                    height = body.get("height") or (1080 if body.get("scale1080") else None)
                    app.start_export(body.get("project") or app.load(), height, body.get("preset"),
                                     bool(body.get("loudness")))
                    return self.send_json(app.export)
                if self.path == "/api/export/cancel":
                    app.cancel_export()
                    return self.send_json({"ok": True})
                if self.path == "/api/reveal":
                    out = app.export.get("output")
                    if out:
                        subprocess.Popen(["xdg-open", str(Path(out).parent)],
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    return self.send_json({"ok": True})
            except (ValueError, TypeError, OSError, subprocess.CalledProcessError, urllib.error.URLError) as e:
                return self.send_json({"error": str(e) or "Could not read that file"}, 400)
            self.send_json({"error": "not found"}, 404)

    return Handler


def free_port():
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def default_browser():
    """The desktop's default browser, if it is Chromium-based (only those have --app windows)."""
    try:
        desktop = subprocess.run(["xdg-settings", "get", "default-web-browser"], capture_output=True,
                                 text=True, timeout=3).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return None
    dirs = [xdg_dir("XDG_DATA_HOME", ".local/share"),
            *map(Path, (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":"))]
    for d in dirs:
        entry = d / "applications" / desktop
        if desktop.endswith(".desktop") and entry.is_file():
            exe = next((shlex.split(line[5:])[0] for line in entry.read_text(errors="ignore").splitlines()
                        if line.startswith("Exec=") and line[5:].strip()), "")
            chromium = any(k in Path(exe).name for k in ("chrom", "brave", "vivaldi", "edge", "thorium", "helium"))
            return exe if chromium and shutil.which(exe) else None
    return None


def open_window(url):
    """Open the editor as a chromeless app window; without a Chromium-based browser, as a normal tab."""
    if cmd := os.environ.get("CUTLINE_BROWSER"):
        argv = shlex.split(cmd)
    else:
        found = default_browser() or next((b for b in BROWSERS if shutil.which(b)), None)
        argv = [found] if found else None
    if argv and shutil.which(argv[0]):
        subprocess.Popen([*argv, f"--app={url}", "--new-window"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    print("cutline: no Chromium-based browser found (set CUTLINE_BROWSER); "
          "opening your default browser instead", file=sys.stderr)
    webbrowser.open(url)


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("-V", "--version"):
        print(f"cutline {VERSION}")
        sys.exit(0)
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help")):
        print(__doc__.strip())
        sys.exit(0 if len(sys.argv) == 2 else 2)
    if not shutil.which("ffmpeg"):
        sys.exit("cutline: ffmpeg is required")
    app = App()
    if len(sys.argv) == 2:
        try:
            app.new_project(sys.argv[1])
        except (ValueError, OSError, subprocess.CalledProcessError) as e:
            sys.exit(f"cutline: {e}")
    port = free_port()
    server = ThreadingHTTPServer(("127.0.0.1", port), handler_for(app))
    threading.Thread(target=server.serve_forever, daemon=True).start()
    url = f"http://127.0.0.1:{port}/?key={app.launch_key}"      # works once: it becomes a cookie
    if not os.environ.get("CUTLINE_NO_BROWSER"):
        open_window(url)
    print(f"cutline: {url}", flush=True)
    try:
        while time.time() - app.last_beat < IDLE_EXIT or app.busy():
            time.sleep(2)
    except KeyboardInterrupt:
        pass
    if app.busy():
        app.cancel_export()
    server.shutdown()


if __name__ == "__main__":
    main()
