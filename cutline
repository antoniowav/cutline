def clean_box(box):
    """A free clip's box, as shares of the canvas. It may hang off the edges a little."""
    box = box if isinstance(box, dict) else FULL_BOX
    return {"x": num(box.get("x", 0), -1, 1), "y": num(box.get("y", 0), -1, 1),
            "w": num(box.get("w", 1), 0.02, 2), "h": num(box.get("h", 1), 0.02, 2)}


def clean_crop(crop):
    """How much is cut off each edge of a clip's picture, as shares of it. At least 5 % of the
    picture stays each way, so a wide shot can be cropped to a tall strip anywhere across it."""
    crop = crop if isinstance(crop, dict) else {}
    out = {side: num(crop.get(side, 0), 0, 0.9) for side in "ltrb"}
    for a, b in (("l", "r"), ("t", "b")):
        if out[a] + out[b] > 0.95:
            k = 0.95 / (out[a] + out[b])
            out[a], out[b] = out[a] * k, out[b] * k
    return out


TRANSITIONS = {"fade": "fade", "dip": "fadeblack", "slide": "slideleft", "wipe": "wipeleft",
               "circle": "circleopen", "zoom": "zoomin"}       # Cutline's name: ffmpeg xfade's
KEY_FIELDS = ("zoom", "fx", "fy", "x", "y", "opacity")


def clean_keys(keys, c):
    """Keyframes: zoom, focus and (for a free clip) position at t seconds into the clip.
    Between two keys the value eases in and out; before the first and after the last it holds."""
    if not isinstance(keys, list):
        return []
    box = c.get("box") if isinstance(c.get("box"), dict) else {}
    out = []
    for k in keys[:64]:
        if not isinstance(k, dict):
            continue
        out.append({"t": num(k.get("t", 0), 0, 1e6), "zoom": num(k.get("zoom", 1), 1, 4),
                    "fx": num(k.get("fx", 0.5), 0, 1), "fy": num(k.get("fy", 0.5), 0, 1),
                    "x": num(k.get("x", box.get("x", 0)), -1, 1), "y": num(k.get("y", box.get("y", 0)), -1, 1),
                    "opacity": num(k.get("opacity", c.get("opacity", 1)), 0, 1)})
    return sorted(out, key=lambda k: k["t"])


def clean_trans(trans):
    """How a clip comes in from the clip right before it on its track."""
    if not isinstance(trans, dict) or trans.get("type") not in TRANSITIONS:
        return None
    return {"type": trans["type"], "dur": num(trans.get("dur", 0.5), 0.1, 3)}


