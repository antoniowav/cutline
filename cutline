def xdg_dir(var, fallback):
    value = os.environ.get(var, "")
    return Path(value) if os.path.isabs(value) else Path.home() / fallback


def videos_dir():
    """$CUTLINE_VIDEOS, else the XDG Videos folder, else ~/Videos."""
    if os.environ.get("CUTLINE_VIDEOS"):
        return Path(os.environ["CUTLINE_VIDEOS"]).expanduser()
    try:
        out = subprocess.run(["xdg-user-dir", "VIDEOS"], capture_output=True, text=True, timeout=3).stdout.strip()
        if out and Path(out) != Path.home():             # xdg-user-dir answers $HOME when it's unset
            return Path(out)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return Path.home() / "Videos"


