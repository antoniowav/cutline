@functools.lru_cache(maxsize=256)
def noise_floor(path, start, length):
    """How loud the background is in a stretch of sound, in dB: the quietest tenth of its 50 ms
    windows, at full bandwidth (hiss lives in the highs). The denoiser is told this, so it takes
    out the hiss and leaves the voice."""
    out = subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{start:.3f}", "-t", f"{min(length, 600):.3f}", "-i", str(path),
                          "-vn", "-ac", "1", "-ar", "48000", "-af",
                          "asetnsamples=n=2400,astats=metadata=1:reset=1,ametadata=print:key=lavfi.astats.Overall.RMS_level:file=-",
                          "-f", "null", "-"], capture_output=True, text=True, timeout=300).stdout
    levels = [float(v) for v in re.findall(r"RMS_level=(-?[\d.]+)", out)]
    if not levels:
        return -50.0
    return sorted(levels)[len(levels) // 10]


def clean_color(color):
    color = color if isinstance(color, dict) else {}
    return {"b": num(color.get("b", 1), 0.3, 2), "c": num(color.get("c", 1), 0.3, 2),
            "s": num(color.get("s", 1), 0, 3), "t": num(color.get("t", 0), -1, 1)}


def clean_key(key):
    """A green screen: the colour to take out, how close a colour must be, how soft the edge."""
    if not isinstance(key, dict) or not key.get("on"):
        return None
    return {"color": colour(key.get("color"), "#00ff00"), "sim": num(key.get("sim", 0.15), 0.01, 0.6),
            "blend": num(key.get("blend", 0.08), 0, 0.5)}


def color_matrix(color):
    """The colour adjustment as one 3x3 matrix and an offset, on RGB in 0..1: brightness, then
    warmth, then saturation (the CSS/SVG saturate matrix), then contrast around the middle.
    The editor's colorMatrix() builds the same, for an SVG feColorMatrix."""
    b, c, s, w = color["b"], color["c"], color["s"], color["t"]
    sat = [[0.213 + 0.787 * s, 0.715 - 0.715 * s, 0.072 - 0.072 * s],
           [0.213 - 0.213 * s, 0.715 + 0.285 * s, 0.072 - 0.072 * s],
           [0.213 - 0.213 * s, 0.715 - 0.715 * s, 0.072 + 0.928 * s]]
    warm = [1 + 0.2 * w, 1 + 0.03 * w, 1 - 0.2 * w]
    m = [[c * sat[i][j] * warm[j] * b for j in range(3)] for i in range(3)]
    return m, 0.5 * (1 - c)


def lut_file(path):
    """A .cube LUT the user picked: only from the LUT folders, and not absurdly big."""
    if not path:
        return None
    real = Path(os.path.realpath(str(path)))
    for root in LUT_DIRS:
        root = Path(os.path.realpath(root))
        if real.suffix.lower() == ".cube" and root in real.parents and real.is_file() and real.stat().st_size <= MAX_LUT:
            return real
    return None


def list_luts():
    files = []
    for root in LUT_DIRS:
        if root.is_dir():
            depth = ("*",) if root == DOWNLOADS else ("*", "*/*")
            files += [f for d in depth for f in root.glob(d) if f.suffix.lower() == ".cube" and f.is_file()]
    return [{"path": str(f), "name": f.stem, "where": home_label(f.parent)}
            for f in sorted(set(files), key=lambda f: f.stem.lower())]


