def xdg_dir(var, fallback):
    value = os.environ.get(var, "")
    return Path(value) if os.path.isabs(value) else Path.home() / fallback


def user_dir(kind, env, fallback):
    """$env, else the XDG user folder of that kind (VIDEOS, DOWNLOAD, ...), else ~/fallback."""
    if os.environ.get(env):
        return Path(os.environ[env]).expanduser()
    try:
        out = subprocess.run(["xdg-user-dir", kind], capture_output=True, text=True, timeout=3).stdout.strip()
        if out and Path(out) != Path.home():             # xdg-user-dir answers $HOME when it's unset
            return Path(out)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return Path.home() / fallback


def videos_dir():
    """$CUTLINE_VIDEOS, else the XDG Videos folder, else ~/Videos."""
    return user_dir("VIDEOS", "CUTLINE_VIDEOS", "Videos")


